# ==============================================================================
# CryptiScan .gitignore
# ==============================================================================

# Apptainer / Singularity Containers (Large SIF files)
*.sif
*.simg
*.sandbox/

# Machine Learning Models & Weights (Large binary files)
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
*.h5
*.hdf5
*.joblib
*.pkl
*.npz
*.npy
*.msgpack
*.gguf
*.ggml
*.pb
*.tflite
*.model
*.weights
# TensorFlow checkpoint shards (e.g. cath_pretrained.data-00000-of-00002)
*.data-[0-9][0-9][0-9][0-9][0-9]-of-[0-9][0-9][0-9][0-9][0-9]
*.index

# Downloaded Weight Directories (under required_files_weights)
pipeline/required_files_weights/prot_t5_xl_uniref50_full_v2/
pipeline/required_files_weights/sam2_weights/
prot_t5_xl_uniref50_full_v2/
sam2_weights/

# Large Compressed Archives & Installers
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z

# Excluded Folders & Vendored Tools
asam/
ESM-Scan/
Mutation_pipeline/
cryptic_sites_software/

# Excluded Pipeline Modules & Manuscript
md_setup/
manuscript/

# Secrets & Environment Configuration
.env
.env.*
*.key

# Pipeline & Simulation Outputs
pipeline_out/
pipeline/pipeline_out/
adk_sam/
test_output*
ensemble_output*
*.log
nohup.out

# Trajectories & Molecular Dynamics Outputs
*.dcd
*.xtc
*.trr
*.nc

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
.virtual_documents/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.claude/