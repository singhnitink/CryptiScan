@article{Steentoft2013,
  title = {Precision Mapping of the Human {{O-GalNAc}} Glycoproteome through {{SimpleCell}} Technology},
  author = {Steentoft, Catharina and Vakhrushev, Sergey Y and Joshi, Hiren J and Kong, Yun and {Vester-Christensen}, Malene B and Schjoldager, Katrine T-B G and Lavrsen, Kirstine and Dabelsteen, Sally and Pedersen, Nis B and {Marcos-Silva}, Lara and Gupta, Ramneek and Paul Bennett, Eric and Mandel, Ulla and Brunak, S{\o}ren and Wandall, Hans H and Levery, Steven B and Clausen, Henrik},
