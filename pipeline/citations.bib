@article{Rotem2006,
  title = {Identification of {{Tyrosine Residues Critical}} for the {{Function}} of an {{Ion-coupled Multidrug Transporter}}},
  author = {Rotem, Dvir and {Steiner-Mordoch}, Sonia and Schuldiner, Shimon},
