@article{Yamashita2020,
  title = {Molecular {{Mechanisms}} of {{Natural Rubber Biosynthesis}}},
  author = {Yamashita, Satoshi and Takahashi, Seiji},
  year = 2020,
  month = jun,
  journal = {Annu. Rev. Biochem.},
  volume = {89},
  number = {1},
