  keywords = {{Thyroid Carcinoma, Anaplastic},{Tumor Cells, Cultured},Apoptosis,Butadienes,Cell Proliferation,Enzyme Inhibitors,Humans,L-GILZ,MAPK,MAPK pathway--inhibiting drugs,NF-{$\kappa$}B,NF-kappa B,Nitriles,Proliferation,Protein Interaction Domains and Motifs,Protein Transport,Proto-Oncogene Mas,RAS mutation,Thyroid cancer,Thyroid Neoplasms,Transcription Factors}
