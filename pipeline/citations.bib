@article{Vaaje-Kolstad2005a,
  title = {Crystal Structure and Binding Properties of the {{Serratia}} Marcescens Chitin-Binding Protein {{CBP21}}},
  author = {{Vaaje-Kolstad}, G and Houston, D R and Riemen, A H K and Eijsink, V G H and {van Aalten}, D M F},
  year = 2005,
  journal = {J. Biol. Chem.},
  volume = {280},
  number = {12},
  pages = {11313--11319},
  doi = {10.1074/jbc.M407175200},
  abstract = {Chitin proteins are commonly found in bacteria that utilize chitin as a source of energy. CBP21 is a chitin-binding protein from Serratia marcescens, a Gram-negative soil bacterium capable of efficient chitin degradation. When grown on chitin, S. marcescens secretes large amounts of CBP21, along with chitin-degrading enzymes. In an attempt to understand the molecular mechanism of CBP21 action, we have determined its crystal structure at 1.55 resolution. This is the first structure to be solved of a family 33 carbohydrate-binding module. The structure reveals a "budded" fibronectin type III fold consisting of two beta-sheets, arranged as a beta-sheet sandwich, with a 65-residue "bud" consisting of three short helices, located between beta-strands 1 and 2. Remarkably, conserved aromatic residues that have been suggested previously to play a role in chitin binding were mainly found in the interior of the protein, seemingly incapable of interacting with chitin, whereas the structure revealed a surface patch of highly conserved, mainly hydrophilic residues. The roles of six of these conserved surface-exposed residues (Tyr-54, Glu-55, Glu-60, His-114, Asp-182, and Asn-185) were probed by site-directed mutagenesis and subsequent binding studies. All single point mutations lowered the affinity of CBP21 for beta-chitin, as shown by 3-8-fold increases in the apparent binding constant. Thus, binding of CBP21 to chitin seems to be mediated primarily by conserved, solvent-exposed, polar side chains.},
  isbn = {0021-9258},
  langid = {english},
  pmid = {15590674},
  keywords = {{Protein Structure, Secondary},alpha-chitin,Amino Acid Sequence,bacillus-circulans wl-12,Bacterial Proteins,Carrier Proteins,cellulose,chb1,Chitin,Crystallography,Dimerization,domain,gene,Intracellular Signaling Peptides and Proteins,mechanism,Molecular Sequence Data,multiple sequence alignment,Protein Structure Secondary,residues,serratia-marcescens-2170}
}
