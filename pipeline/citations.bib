@article{Naon2023,
  title = {Splice Variants of Mitofusin 2 Shape the Endoplasmic Reticulum and Tether It to Mitochondria},
  author = {Na{\'o}n, D{\'e}borah and {Hern{\'a}ndez-Alvarez}, Mar{\'i}a Isabel and Shinjo, Satoko and Wieczor, Milosz and Ivanova, Saska and {Martins de Brito}, Olga and Quintana, Albert and Hidalgo, Juan and Palac{\'i}n, Manuel and Aparicio, Pilar and Castellanos, Juan and Lores, Luis and Sebasti{\'a}n, David and {Fern{\'a}ndez-Veledo}, Sonia and Vendrell, Joan and Joven, Jorge and Orozco, Modesto and Zorzano, Antonio and Scorrano, Luca},
  year = 2023,
