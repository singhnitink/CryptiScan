@article{Kleinfeld1984,
  title = {Electron Transfer in Reaction Centers of {{Rhodopseudomonas}} Sphaeroides. {{I}}. {{Determination}} of the Charge Recombination Pathway of {{D}}+{{QAQ}}(-){{B}} and Free Energy and Kinetic Relations between {{Q}}(-){{AQB}} and {{QAQ}}(-){{B}}.},
