@article{Scafaro2011,
  title = {Temperature Response of Mesophyll Conductance in Cultivated and Wild {{{\emph{Oryza}}}} Species with Contrasting Mesophyll Cell Wall Thickness},
  author = {Scafaro, Andrew P. and Von Caemmerer, Susanne and Evans, John R. and Atwell, Brian J.},
  year = 2011,
  month = nov,
  journal = {Plant Cell Environ.},
  volume = {34},
  number = {11},
  pages = {1999--2008},
  issn = {0140-7791, 1365-3040},
  doi = {10.1111/j.1365-3040.2011.02398.x},
  urldate = {2023-11-16},
  abstract = {ABSTRACT A critical component of photosynthetic capacity is the conductance of CO 2 from intercellular airspaces to the sites of CO 2 fixation in the stroma of chloroplasts, termed mesophyll conductance ( g m ). Leaf anatomy has been identified as an important determinant of g m . There are few studies of the temperature response of g m and none has examined the implications of leaf anatomy. Hence, we compared a cultivar of Oryza sativa with two wild Oryza relatives endemic to the hot northern savannah of Australia, namely Oryza meridionalis and Oryza australiensis . All three species had similar leaf anatomical properties, except that the wild relatives had significantly thicker mesophyll cell walls than O.{$\quad$}sativa . Thicker mesophyll cell walls in the wild rice species are likely to have contributed to the reduction in g m , which was associated with a greater drawdown of CO 2 into chloroplasts ( C i -- C c ) compared with O.{$\quad$}sativa . Mesophyll conductance increased at higher temperatures, whereas the rate of CO 2 assimilation was relatively stable between 20 and 40{$\quad^\circ$}C. Consequently, C i -- C c decreased for all three species as temperature increased. , The work entitled `Temperature response of mesophyll conductance in cultivated and wild Oryza species with contrasting mesophyll cell wall thickness' is important in that it connects mesophyll conductance with leaf anatomy over a wide temperature range. It is the first report of a temperature response of mesophyll conductance in rice. By examining two wild relatives of rice about which little is known, we have identified differences in the thickness of mesophyll cell walls. Thicker cell walls reduce mesophyll conductance and increase CO2 drawdown to chloroplasts. However the responsiveness of mesophyll conductance to temperature was not dependent on wall thickness, with mesophyll conductance increasing substantially at higher temperatures.},
  langid = {english},
  pmid = {21752031},
  keywords = {Agriculture,Analysis of Variance,Carbon Dioxide,Carbon Isotopes,Cell Wall,Chloroplasts,Mesophyll Cells,Oryza,Partial Pressure,Photosynthesis,Plant Stomata,Plant Transpiration,Species Specificity,Temperature,Thermodynamics}
}
