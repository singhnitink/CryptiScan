@article{Li2024a,
  title = {Proton-Coupled Transport Mechanism of the Efflux Pump {{NorA}}},
  author = {Li, Jianping and Li, Yan and Koide, Akiko and Kuang, Huihui and Torres, Victor J. and Koide, Shohei and Wang, Da-Neng and Traaseth, Nathaniel J.},
  year = 2024,
