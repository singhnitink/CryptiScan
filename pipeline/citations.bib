@techreport{Shekhar2019,
  type = {Preprint},
  title = {{{CryoFold}}: {{Determining}} Protein Structures and Ensembles from Cryo-{{EM}} Data},
  shorttitle = {{{CryoFold}}},
  author = {Shekhar, Mrinal and Terashi, Genki and Gupta, Chitrak and Sarkar, Daipayan and Debussche, Gaspard and Sisco, Nicholas J. and Nguyen, Jonathan and Mondal, Arup and Zook, James and Vant, John and Fromme, Petra and Van Horn, Wade D. and Tajkhorshid, Emad and Kihara, Daisuke and Dill, Ken and Perez, Alberto and Singharoy, Abhishek},
  year = 2019,
  month = jul,
  institution = {Biophysics},
  doi = {10.1101/687087},
  urldate = {2021-05-26},
  abstract = {Cryo-EM is a powerful method for determining protein structures. But it requires computational assistance. Physics-based computations have the power to give low-free-energy structures and ensembles of populations, but have been computationally limited to only small soluble proteins. Here, we introduce CryoFold. By integrating data of varying sparsity from electron density maps of 3--5 \AA{} resolution with coarse-grained physical knowledge of secondary and tertiary interactions, CryoFold determines ensembles of protein structures directly from sequence. We give six examples showing its broad capabilities, over proteins ranging from 72 to 2000 residues, including membrane and multi-domain proteins, and including results from two EMDB competitions. The ensembles CryoFold predicts starting from the density data of a single known protein conformation encompass multiple low-energy conformations, all of which are experimentally validated and biologically relevant.},
  langid = {english}
}

