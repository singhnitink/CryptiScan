@article{Bey2013,
  title = {Cello-{{Oligosaccharide Oxidation Reveals Differences}} between {{Two Lytic Polysaccharide Monooxygenases}} ({{Family GH61}}) from {{Podospora}} Anserina},
  author = {Bey, Mathieu and Zhou, Simeng and Poidevin, Laetitia and Henrissat, Bernard and Coutinho, Pedro M and Berrin, J.-G. and Sigoillot, J.-C.},
