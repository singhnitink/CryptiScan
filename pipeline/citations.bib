@article{Witzler2018,
  title = {Lignin-{{Derived Biomaterials}} for {{Drug Release}} and {{Tissue Engineering}}},
  author = {Witzler, Markus and Alzagameem, Abla and Bergs, Michel and {Khaldi-Hansen}, Basma El and Klein, Stephanie E. and Hielscher, Dorothee and Kamm, Birgit and Kreyenschmidt, Judith and Tobiasch, Edda and Schulze, Margit},
