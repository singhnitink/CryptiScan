@article{Sudhof2011,
  title = {Synaptic Vesicle Exocytosis.},
  author = {S{\"u}dhof, Thomas C and Rizo, Josep},
  year = 2011,
  month = dec,
  journal = {Cold Spring Harb. Perspect. Biol.},
  volume = {3},
