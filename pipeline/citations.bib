@article{Daum1999a,
  title = {Systematic Analysis of Yeast Strains with Possible Defects in Lipid Metabolism.},
  author = {Daum, G and Tuller, G and Nemec, T and Hrastnik, C and Balliano, G and Cattel, L and Milla, P and Rocco, F and Conzelmann, a and Vionnet, C and Kelly, D E and Kelly, S and Schweizer, E and Sch{\"u}ller, H J and Hojad, U and Greiner, E and Finger, K},
  year = 1999,
  month = may,
  journal = {Yeast Chichester Engl.},
