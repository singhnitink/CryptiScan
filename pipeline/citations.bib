@article{Mizokami2015,
  title = {Mesophyll Conductance Decreases in the Wild Type but Not in an {{{\textsc{ABA}}}} -Deficient Mutant ( {\textsc{ {\emph{Aba1}} }} ) of {\textsc{ }}{{{\textsc{{\emph{N}}}}}}{\textsc{ }} {\emph{Icotiana Plumbaginifolia}} under Drought Conditions},
  shorttitle = {Mesophyll Conductance Decreases in the Wild Type but Not in An},
  author = {Mizokami, Yusuke and Noguchi, Ko and Kojima, Mikiko and Sakakibara, Hitoshi and Terashima, Ichiro},
  year = 2015,
  month = mar,
  journal = {Plant Cell Environ.},
  volume = {38},
  number = {3},
  pages = {388--398},
  issn = {0140-7791, 1365-3040},
  doi = {10.1111/pce.12394},
  urldate = {2023-11-16},
  abstract = {Abstract Under drought conditions, leaf photosynthesis is limited by the supply of CO 2 . Drought induces production of abscisic acid ( ABA ), and ABA decreases stomatal conductance ( g s ). Previous papers reported that the drought stress also causes the decrease in mesophyll conductance ( g m ). However, the relationships between ABA content and g m are unclear. We investigated the responses of g m to the leaf ABA content [( ABA ) L ] using an ABA -deficient mutant, aba1 , and the wild type ( WT ) of N icotiana plumbaginifolia . We also measured leaf water potential ( {$\Psi$} L ) because leaf hydraulics may be related to g m . Under drought conditions, g m decreased with the increase in ( ABA ) L in WT , whereas both ( ABA ) L and g m were unchanged by the drought treatment in aba1 . Exogenously applied ABA decreased g m in both WT and aba1 in a dose-dependent manner. {$\Psi$} L in WT was decreased by the drought treatment to -0.7\, MPa , whereas {$\Psi$} L in aba1 was around -0.8\, MPa even under the well-watered conditions and unchanged by the drought treatment. From these results, we conclude that the increase in ( ABA ) L is crucial for the decrease in g m under drought conditions. We discuss possible relationships between the decrease in g m and changes in the leaf hydraulics. , This study aimed at investigating the possible involvement of ABA in decreasing mesophyll conductance under drought conditions. Here, we used the ABA deficient mutant of Nicotiana plumbaginifolia, aba1, and photosynthetic characteristics of this mutant and the wild type were compared. The experiments provided the clear evidence that the increase in leaf ABA decreased mesophyll conductance. Commentary: Superimposed behaviour of gm under ABA-induced stomata closing and low CO2},
  langid = {english},
  pmid = {24995523},
  keywords = {Abscisic Acid,abscisic acid (ABA),Droughts,Mutation,Nicotiana,Photosynthesis,Plant Growth Regulators,stomatal conductance,Tobacco,Water}
}
