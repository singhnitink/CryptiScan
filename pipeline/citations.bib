@article{Howery2012,
  title = {A Designed Inhibitor of a {{CLC}} Antiporter Blocks Function through a Unique Binding Mode.},
  author = {Howery, Andrew E and Elvington, Shelley and Abraham, Sherwin J and Choi, Kee-Hyun and {Dworschak-Simpson}, Sierra and Phillips, Sabrina and Ryan, Christopher M and Sanford, R Lea and Almqvist, Jonas and Tran, Kevin and Chew, Thomas A and Zachariae, Ulrich and Andersen, Olaf S and Whitelegge, Julian and Matulef, Kimberly and Du Bois, Justin and Maduke, Merritt C},
