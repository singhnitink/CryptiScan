@article{Savage2003,
  title = {Architecture and Selectivity in Aquaporins: 2.5 ?? {{X-ray}} Structure of Aquaporin {{Z}}},
  shorttitle = {Architecture and {{Selectivity}} in {{Aquaporins}}},
  author = {Savage, David F and Egea, Pascal F and {Robles-Colmenares}, Yaneth and {Joseph D. O'Connell III} and Stroud, Robert M},
