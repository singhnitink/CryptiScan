@article{Saxe2014,
  title = {Measuring the Distribution of Cellulose Microfibril Angles in Primary Cell Walls by Small Angle {{X-ray}} Scattering},
  author = {Saxe, Friederike and Eder, Michaela and Benecke, Gunthard and Aichmayer, Barbara and Fratzl, Peter and Burgert, Ingo and R{\"u}ggeberg, Markus},
