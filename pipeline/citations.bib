@article{Sternal2004,
  title = {Molecular Aspects of the Interaction between Amphotericin {{B}} and a Phospholipid Bilayer: {{Molecular}} Dynamics Studies.},
  author = {Sternal, Kamil and Czub, Jacek and Baginski, Maciej},
  year = 2004,
  month = jun,
