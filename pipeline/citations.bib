@article{franks1986,
  title = {Partitioning of Long-Chain Alcohols into Lipid Bilayers: {{Implications}} for Mechanisms of General Anesthesia},
  shorttitle = {Partitioning of Long-Chain Alcohols into Lipid Bilayers},
  author = {Franks, N. P. and Lieb, W. R.},
