@article{Ivars-Barcelo2018,
  title = {Novel {{Applications}} of {{Microbial Fuel Cells}} in {{Sensors}} and {{Biosensors}}},
  author = {{Ivars-Barcel{\'o}}, Francisco and Zuliani, Alessio and Fallah, Marjan and Mashkour, Mehrdad and Rahimnejad, Mostafa and Luque, Rafael},
  year = 2018,
  month = jul,
  journal = {Appl. Sci.},
  volume = {8},
  number = {7},
  pages = {1184},
  issn = {2076-3417},
  doi = {10.3390/app8071184},
  urldate = {2023-05-19},
  abstract = {A microbial fuel cell (MFC) is a type of bio-electrochemical system with novel features, such as electricity generation, wastewater treatment, and biosensor applications. In recent years, progressive trends in MFC research on its chemical, electrochemical, and microbiological aspects has resulted in its noticeable applications in the field of sensing. This review was consequently aimed to provide an overview of the most interesting new applications of MFCs in sensors, such as providing the required electrical current and power for remote sensors (energy supply device for sensors) and detection of pollutants, biochemical oxygen demand (BOD), and specific DNA strands by MFCs without an external analytical device (self-powered biosensors). Moreover, in this review, procedures of MFC operation as a power supply for pH, temperature, and organic loading rate (OLR) sensors, and also self-powered biosensors of toxicity, pollutants, and BOD have been discussed.},
  langid = {english}
}
