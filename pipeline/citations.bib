@article{Becker2015,
  title = {A Historic and Scientific Review of Breast Cancer: {{The}} next Global Healthcare Challenge},
  shorttitle = {A Historic and Scientific Review of Breast Cancer},
  author = {Becker, Sven},
  year = 2015,
  month = oct,
  journal = {Intl J Gynecol. Obste},
  volume = {131},
  number = {S1},
  issn = {0020-7292, 1879-3479},
