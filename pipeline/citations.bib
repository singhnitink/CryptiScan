@article{Gruenberg2023,
  title = {A Common Inducer Molecule Enhances Sugar Utilization by {{{\emph{Shewanella}}}}{\emph{ Oneidensis}} {{MR-1}}},
  author = {Gruenberg, Megan C and TerAvest, Michaela A},
