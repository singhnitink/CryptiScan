@article{DelMundo2023,
  title = {Grazing-Incidence Diffraction Reveals Cellulose and Pectin Organization in Hydrated Plant Primary Cell Wall},
  author = {Del Mundo, Joshua T. and Rongpipi, Sintu and Yang, Hui and Ye, Dan and Kiemle, Sarah N. and Moffitt, Stephanie L. and Troxel, Charles L. and Toney, Michael F. and Zhu, Chenhui and Kubicki, James D. and Cosgrove, Daniel J. and Gomez, Esther W. and Gomez, Enrique D.},
