@article{Sauer2024,
  title = {Structural and Quantum Chemical Basis for {{OCP-mediated}} Quenching of Phycobilisomes},
  author = {Sauer, Paul V. and Cupellini, Lorenzo and Sutter, Markus and Bondanza, Mattia and Dom{\'i}nguez Martin, Mar{\'i}a Agustina and Kirst, Henning and B{\'i}na, David and Koh, Adrian Fujiet and Kotecha, Abhay and Greber, Basil J. and Nogales, Eva and Pol{\'i}vka, Tom{\'a}{\v s} and Mennucci, Benedetta and Kerfeld, Cheryl A.},
  year = 2024,
