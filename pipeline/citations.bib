@article{Ni2023,
  title = {Intrinsically Disordered {{CsoS2}} Acts as a General Molecular Thread for {$\alpha$}-Carboxysome Shell Assembly},
  author = {Ni, Tao and Jiang, Qiuyao and Ng, Pei Cing and Shen, Juan and Dou, Hao and Zhu, Yanan and Radecke, Julika and Dykes, Gregory F. and Huang, Fang and Liu, Lu-Ning and Zhang, Peijun},
  year = 2023,
  month = sep,
  journal = {Nat Commun},
  volume = {14},
  number = {1},
  pages = {5512},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-023-41211-y},
  urldate = {2024-01-29},
  abstract = {Carboxysomes are a paradigm of self-assembling proteinaceous organelles found in nature, offering compartmentalisation of enzymes and pathways to enhance carbon fixation. In {$\alpha$}-carboxysomes, the disordered linker protein CsoS2 plays an essential role in carboxysome assembly and Rubisco encapsulation. Its mechanism of action, however, is not fully understood. Here we synthetically engineer {$\alpha$}-carboxysome shells using minimal shell components and determine cryoEM structures of these to decipher the principle of shell assembly and encapsulation. The structures reveal that the intrinsically disordered CsoS2 C-terminus is well-structured and acts as a universal ``molecular thread'' stitching through multiple shell protein interfaces. We further uncover in CsoS2 a highly conserved repetitive key interaction motif, [IV]TG, which is critical to the shell assembly and architecture. Our study provides a general mechanism for the CsoS2-governed carboxysome shell assembly and cargo encapsulation and further advances synthetic engineering of carboxysomes for diverse biotechnological applications.},
  copyright = {2023 The Author(s)},
  langid = {english},
