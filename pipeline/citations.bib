@article{Karkehabadi2008,
  title = {The {{First Structure}} of a {{Glycoside Hydrolase Family}} 61 {{Member}}, {{Cel61B}} from {{Hypocrea}} Jecorina, at 1.6 Angstrom {{Resolution}}},
  author = {Karkehabadi, S and Hansson, H and Kim, S and Piens, K and Mitchinson, C and Sandgren, M},
  year = 2008,
  journal = {J. Mol. Biol.},
  volume = {383},
  number = {1},
  pages = {144--154},
  issn = {0022-2836},
  doi = {10.1016/j.jmb.2008.08.016},
  abstract = {The glycoside hydrolase (GH) family 61 is a long-recognized, but still recondite, class of proteins, with little known about the activity, mechanism or function of its more than 70 members. The best-studied GH family 61 member, Cel61A of the filamentous fungus Hypocrea jecorina, is known to be an endoglucanase, but it is not clear if this represents the main activity or function of this family in vivo. We present here the first structure for this family, that of Cel61B from H. jecorina. The best-quality crystals were formed in the presence of nickel, and the crystal structure was solved to 1.6 angstrom resolution using a single-wavelength anomalous dispersion method with nickel as the source of anomalous scatter. Cel61B lacks a carbohydrate-binding module and is a single-domain protein that folds into a twisted beta-sandwich. A structure-aided sequence alignment of all GH family 61 proteins identified a highly conserved group of residues on the surface of Cel61B. Within this patch of mostly polar amino acids was a site occupied by the intramolecular nickel hexacoordinately bound in the solved structure. In the Cel61B structure, there is no easily identifiable carbohydrate-binding cleft or pocket or catalytic center of the types normally seen in GHs. A structural comparison search showed that the known structure most similar to Cel61B is that of CBP21 from the Gram-negative soil bacterium Serratia marcescens, a member of the carbohydrate-binding module family 33 proteins. A polar surface patch highly conserved in that structural family has been identified in CBP21 and shown to be involved in chitin binding and in the protein's enhancement of chitinase activities. The analysis of the Cel61B structure is discussed in light of our continuing research to better understand the activities and function of GH family 61. (C) 2008 Elsevier Ltd. All rights reserved.},
  isbn = {0022-2836},
  langid = {english},
  pmid = {18723026},
  keywords = {{Crystallography, X-Ray},{Genes, Fungal},{Models, Molecular},{Protein Processing, Post-Translational},{Protein Structure, Secondary},{Sequence Homology, Amino Acid},Amino Acid Sequence,Base Sequence,binding protein cbp21,Binding Sites,Cel61B,crystal-structure,Crystallography X-Ray,DNA Primers,electron-density maps,expression,fungus trichoderma-reesei,Genes Fungal,glycoside hydrolase family 61,Glycoside Hydrolases,Hypocrea,industrial fungus,jecorina,macromolecular structures,maximum-likelihood,Models Molecular,Molecular Sequence Data,Nickel,protein crystal structure,Protein Folding,Protein Processing Post-Translational,Protein Structure Secondary,Recombinant Proteins,Sequence Homology Amino Acid,serratia-marcescens,Static Electricity,structure refinement,Trichoderma,Trichoderma reesei}
}
