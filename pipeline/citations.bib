@article{Kim2010,
  title = {Functional Characterization of Transcription Factor Motifs Using Cross-Species Comparison across Large Evolutionary Distances.},
  author = {Kim, Jaebum and Cunningham, Ryan and James, Brian and Wyder, Stefan and Gibson, Joshua D and Niehuis, Oliver and Zdobnov, Evgeny M and Robertson, Hugh M and Robinson, Gene E and Werren, John H and Sinha, Saurabh},
  year = 2010,
