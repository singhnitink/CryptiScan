@article{Wang2011b,
  title = {Application of Molecular Dynamics Simulations in Molecular Property Prediction {{II}}: {{Diffusion}} Coefficient},
  shorttitle = {Application of Molecular Dynamics Simulations in Molecular Property Prediction {{II}}},
  author = {Wang, Junmei and Hou, Tingjun},
