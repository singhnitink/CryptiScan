  isbn = {0002-7863 (Print)},
  langid = {english},
  pmid = {12149011},
  keywords = {Cellulose,Cellulose: chemistry,Crystallography,Deuterium,Hydrogen Bonding,Models,Molecular,Molecular Conformation,Neutron Activation Analysis,Synchrotrons,Thermodynamics,X-Ray}
