@article{Hagen2018,
  title = {Programmed Loading and Rapid Purification of Engineered Bacterial Microcompartment Shells},
  author = {Hagen, Andrew and Sutter, Markus and Sloan, Nancy and Kerfeld, Cheryl A.},
  year = 2018,
  month = jul,
  journal = {Nat Commun},
