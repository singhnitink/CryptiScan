@article{Field1998,
  title = {Primary {{Production}} of the {{Biosphere}}: {{Integrating Terrestrial}} and {{Oceanic Components}}},
  author = {Field, C. B. and Behrenfeld, M. J. and Randerson, J. T. and Falkowski, P.},
  year = 1998,
