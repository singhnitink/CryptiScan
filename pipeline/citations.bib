@article{Hu2010,
  title = {Crystal Structures of a {{Populus}} Tomentosa 4-Coumarate:{{CoA}} Ligase Shed Light on Its Enzymatic Mechanisms.},
  author = {Hu, Yonglin and Gai, Ying and Yin, Lei and Wang, Xiaoxue and Feng, Chunyan and Feng, Lei and Li, Defeng and Jiang, Xiang-Ning and Wang, Da-Cheng},
