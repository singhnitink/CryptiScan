@article{Galazzo2020,
  title = {Spin-Labeled Nanobodies as Protein Conformational Reporters for Electron Paramagnetic Resonance in Cellular Membranes},
  author = {Galazzo, Laura and Meier, Gianmarco and Timachi, M. Hadi and Hutter, Cedric A. J. and Seeger, Markus A. and Bordignon, Enrica},
  year = 2020,
