@article{Wen2010,
  title = {Distinct Roles for Two Synaptotagmin Isoforms in Synchronous and Asynchronous Transmitter Release at Zebrafish Neuromuscular Junction.},
  author = {Wen, Hua and Linhoff, Michael W and McGinley, Matthew J and Li, Geng-Lin and Corson, Glen M and Mandel, Gail and Brehm, Paul},
