@article{Wilson2008,
  title = {A Photoactive Carotenoid Protein Acting as Light Intensity Sensor},
  author = {Wilson, Adj{\'e}l{\'e} and Punginelli, Claire and Gall, Andrew and Bonetti, Cosimo and Alexandre, Maxime and Routaboul, Jean-Marc and Kerfeld, Cheryl A. and Van Grondelle, Rienk and Robert, Bruno and Kennis, John T. M. and Kirilovsky, Diana},
