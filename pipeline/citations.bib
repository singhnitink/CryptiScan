@article{Bjerg2018,
  title = {Long-Distance Electron Transport in Individual, Living Cable Bacteria},
  author = {Bjerg, Jesper T. and Boschker, Henricus T. S. and Larsen, Steffen and Berry, David and Schmid, Markus and Millo, Diego and Tataru, Paula and Meysman, Filip J. R. and Wagner, Michael and Nielsen, Lars Peter and Schramm, Andreas},
