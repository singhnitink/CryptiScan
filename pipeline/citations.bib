@article{Ford2023,
  title = {The Electron Transport Chain of {{{\emph{Shewanella}}}}{\emph{ Oneidensis}} {{MR-1}} Can Operate Bidirectionally to Enable Microbial Electrosynthesis},
  author = {Ford, Kathryne C. and TerAvest, Michaela A.},
