@article{Lindner2013,
  title = {Solvent-Driven Preferential Association of Lignin with Regions of Crystalline Cellulose in Molecular Dynamics Simulation},
  author = {Lindner, Benjamin and Petridis, Loukas and Schulz, Roland and Smith, Jeremy C.},
  year = 2013,
