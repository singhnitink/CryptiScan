@article{Nitsos2013,
  title = {Optimization of {{Hydrothermal Pretreatment}} of {{Lignocellulosic Biomass}} in the {{Bioethanol Production Process}}},
  author = {Nitsos, Christos K. and Matis, Konstantinos A. and Triantafyllidis, Kostas S.},
