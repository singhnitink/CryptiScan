@article{Baker2021,
  title = {{{ChAdOx1}} Interacts with {{CAR}} and {{PF4}} with Implications for Thrombosis with Thrombocytopenia Syndrome},
  author = {Baker, Alexander T. and Boyd, Ryan J. and Sarkar, Daipayan and {Teijeira-Crespo}, Alicia and Chan, Chun Kit and Bates, Emily and Waraich, Kasim and Vant, John and Wilson, Eric and Truong, Chloe D. and {Lipka-Lloyd}, Magdalena and Fromme, Petra and Vermaas, Josh and Williams, Dewight and Machiesky, LeeAnn and Heurich, Meike and Nagalo, Bolni M. and Coughlan, Lynda and Umlauf, Scott and Chiu, Po-Lin and Rizkallah, Pierre J. and Cohen, Taylor S. and Parker, Alan L. and Singharoy, Abhishek and Borad, Mitesh J.},
