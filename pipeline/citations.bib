@article{Pingali2020,
  title = {Deconstruction of Biomass Enabled by Local Demixing of Cosolvents at Cellulose and Lignin Surfaces},
  author = {Pingali, Sai Venkatesh and Smith, Micholas Dean and Liu, Shih-Hsien and Rawal, Takat B. and Pu, Yunqiao and Shah, Riddhi and Evans, Barbara R. and Urban, Volker S. and Davison, Brian H. and Cai, Charles M. and Ragauskas, Arthur J. and O'Neill, Hugh M. and Smith, Jeremy C. and Petridis, Loukas},
  year = 2020,
  month = jul,
  journal = {Proc. Natl. Acad. Sci.},
  volume = {117},
  number = {29},
  pages = {16776--16781},
  issn = {0027-8424},
  doi = {10.1073/pnas.1922883117},
  abstract = {A particularly promising approach to deconstructing and fractionating lignocellulosic biomass to produce green renewable fuels and high-value chemicals pretreats the biomass with organic solvents in aqueous solution. Here, neutron scattering and molecular-dynamics simulations reveal the temperature-dependent morphological changes in poplar wood biomass during tetrahydrofuran (THF):water pretreatment and provide a mechanism by which the solvent components drive efficient biomass breakdown. Whereas lignin dissociates over a wide temperature range ({$>$}25 {$^\circ$}C) cellulose disruption occurs only above 150 {$^\circ$}C. Neutron scattering with contrast variation provides direct evidence for the formation of THF-rich nanoclusters (R g {$\sim$} 0.5 nm) on the nonpolar cellulose surfaces and on hydrophobic lignin, and equivalent water-rich nanoclusters on polar cellulose surfaces. The disassembly of the amphiphilic biomass is thus enabled through the local demixing of highly functional cosolvents, THF and water, which preferentially solvate specific biomass surfaces so as to match the local solute polarity. A multiscale description of the efficiency of THF:water pretreatment is provided: matching polarity at the atomic scale prevents lignin aggregation and disrupts cellulose, leading to improvements in deconstruction at the macroscopic scale.},
  pmcid = {PMC7382264},
  pmid = {32636260},
  keywords = {Bacterial Proteins,biomass,Biomass,Biotechnology,Cellulase,Furans,Gluconacetobacter xylinus,Hydrolysis,Lignin,Populus,pretreatment,solvents,Solvents,Surface-Active Agents,Wood}
}
