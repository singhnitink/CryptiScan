@article{Kim2014a,
  title = {Quantum Mechanical Calculations Suggest That Lytic Polysaccharide Monooxygenases Use a Copper-Oxyl, Oxygen-Rebound Mechanism},
  author = {Kim, Seonah and Stahlberg, J. and Sandgren, Mats and Paton, Robert S and Beckham, Gregg T},
