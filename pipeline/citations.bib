@article{Li2012,
  title = {Structural Basis for Substrate Targeting and Catalysis by Fungal Polysaccharide Monooxygenases.},
  author = {Li, Xin and Beeson, William T and Phillips, Christopher M and Marletta, Michael A and Cate, Jamie H D},
  year = 2012,
  month = jun,
  journal = {Structure},
  volume = {20},
  number = {6},
  pages = {1051--1061},
  issn = {1878-4186},
  doi = {10.1016/j.str.2012.04.002},
  urldate = {2013-12-13},
  abstract = {The use of cellulases remains a major cost in the production of renewable fuels and chemicals from lignocellulosic biomass. Fungi secrete copper-dependent polysaccharide monooxygenases (PMOs) that oxidatively cleave crystalline cellulose and improve the effectiveness of cellulases. However, the means by which PMOs recognize and cleave their substrates in the plant cell wall remain unclear. Here, we present structures of Neurospora crassa PMO-2 and PMO-3 at 1.10 and 1.37 \AA{} resolution, respectively. In the structures, dioxygen species are found in the active sites, consistent with the proposed cleavage mechanism. Structural and sequence comparisons between PMOs also reveal that the enzyme substrate-binding surfaces contain highly varied aromatic amino acid and glycosylation positions. The structures reported here provide evidence for a wide range of PMO substrate recognition patterns in the plant cell wall, including binding modes that traverse multiple glucan chains.},
  pmcid = {PMC3753108},
  pmid = {22578542},
  keywords = {{Crystallography, X-Ray},{Protein Structure, Secondary},Amino Acid Sequence,Biocatalysis,Catalytic Domain,Conserved Sequence,Coordination Complexes,Coordination Complexes: chemistry,Copper,Copper: chemistry,Crystallography,Crystallography X-Ray,Cystine,Cystine: chemistry,Fungal Proteins,Fungal Proteins: chemistry,Mixed Function Oxygenases,Mixed Function Oxygenases: chemistry,Molecular Sequence Data,Neurospora crassa,Neurospora crassa: enzymology,Oxygen,Oxygen: chemistry,Protein Binding,Protein Structure,Protein Structure Secondary,Secondary,Substrate Specificity,Surface Properties,X-Ray}
}
