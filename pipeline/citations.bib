  title = {Conversion of Cis Unsaturated Fatty Acids to Trans, a Possible Mechanism for the Protection of Phenol-Degrading {{Pseudomonas}} Putida {{P8}} from Substrate Toxicity},
  author = {Heipieper, H J and Diefenbach, R and Keweloh, H},
  year = 1992,
