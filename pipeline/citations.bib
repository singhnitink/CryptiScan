@article{Antonny2011,
  title = {Mechanisms of Membrane Curvature Sensing.},
  author = {Antonny, Bruno},
  year = 2011,
  month = jan,
  journal = {Annu. Rev. Biochem.},
  volume = {80},
  eprint = {21438688},
