@article{Taguchi2013,
  title = {Tuning {{Cofactor Redox Potentials}}: {{The}} 2-{{Methoxy Dihedral Angle Generates}} a {{Redox Potential Difference}} of {$>$}160 {{mV}} between the {{Primary}} ({{Q A}} ) and {{Secondary}} ({{Q B}} ) {{Quinones}} of the {{Bacterial Photosynthetic Reaction Center}}},
  author = {Taguchi, Alexander T and Mattis, Aidas J and O'Malley, Patrick J. and Dikanov, Sergei A and Wraight, Colin A},
  year = 2013,
  month = oct,
  journal = {Biochemistry},
  volume = {52},
  number = {41},
  pages = {7164--7166},
  issn = {0006-2960},
  doi = {10.1021/bi4011896},
  urldate = {2013-11-09},
  abstract = {Only quinones with a 2-methoxy group can act simultaneously as the primary (QA) and secondary (QB) electron acceptors in photosynthetic reaction centers from Rhodobacter sphaeroides. (13)C hyperfine sublevel correlation measurements of the 2-methoxy in the semiquinone states, SQA and SQB, were compared with quantum mechanics calculations of the (13)C couplings as a function of the dihedral angle. X-ray structures support dihedral angle assignments corresponding to a redox potential gap ({$\Delta$}Em) between QA and QB of {$\sim$}180 mV. This is consistent with the failure of a ubiquinone analogue lacking the 2-methoxy to function as QB in mutant reaction centers with a {$\Delta$}Em of {$\approx$}160-195 mV.},
  pmcid = {PMC3859466},
  pmid = {24079813},
  keywords = {{Chromatography, Thin Layer},{Cranial Fossa, Posterior},{Infant, Newborn},{Infant, Premature},{Microsomes, Liver},{Models, Molecular},Ammonia-Lyases,Animals,Aspartate Ammonia-Lyase,Bacterial Proteins,Binding Sites,Brain,Brain Stem,Cattle,Cerebellum,Cerebral Cortex,Coenzymes,Digitoxigenin,Digitoxin,Echoencephalography,Electron Transport,Enzyme Activation,Escherichia coli,Gestational Age,Humans,Hydrogen-Ion Concentration,Hydroxylation,In Vitro Techniques,Infant,Kinetics,Male,Medulla Oblongata,Mesencephalon,Models Molecular,NADP,Neural Pathways,Oxidation-Reduction,Pancreas,Photosynthetic Reaction Center Complex Proteins,Pons,Quinones,Rats,Rhodobacter sphaeroides,Time Factors,Trypsin}
}
