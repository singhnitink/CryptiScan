@article{Coradetti2012,
  title = {Conserved and Essential Transcription Factors for Cellulase Gene Expression in Ascomycete Fungi},
  author = {Coradetti, Samuel T and Craig, James P and Xiong, Yi and Shock, Teresa and Tian, Chaoguang and Glass, N Louise},
  year = 2012,
