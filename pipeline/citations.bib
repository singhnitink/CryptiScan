@article{Wraight2008,
  title = {The 2-Methoxy Group of Ubiquinone Is Essential for Function of the Acceptor Quinones in Reaction Centers from {{Rba}}. {{Sphaeroides}}},
  author = {Wraight, Colin A and Vakkasoglu, Ahmet S and Poluektov, Yuri and Mattis, Aidas J and Nihan, Danielle and Lipshutz, Bruce H},
