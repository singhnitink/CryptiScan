@article{Rahikainen2013a,
  title = {Cellulase-Lignin Interactions-{{The}} Role of Carbohydrate-Binding Module and {{pH}} in Non-Productive Binding},
  author = {Rahikainen, Jenni Liisa and Evans, James David and Mikander, Saara and Kalliola, Anna and Puranen, Terhi and Tamminen, Tarja and Marjamaa, Kaisa and Kruus, Kristiina},
  year = 2013,
  month = oct,
  journal = {Enzyme Microb. Technol.},
  volume = {53},
  number = {5},
  pages = {315--321},
  issn = {1879-0909 (Electronic) 0141-0229 (Linking)},
  doi = {10.1016/j.enzmictec.2013.07.003},
  urldate = {2014-06-19},
  abstract = {Non-productive cellulase adsorption onto lignin is a major inhibitory mechanism preventing enzymatic hydrolysis of lignocellulosic feedstocks. Therefore, understanding of enzyme-lignin interactions is essential for the development of enzyme mixtures and processes for lignocellulose hydrolysis. We have studied cellulase-lignin interactions using model enzymes, Melanocarpus albomyces Cel45A endoglucanase ( MaCel45A) and its fusions with native and mutated carbohydrate-binding modules (CBMs) from Trichoderma reesei Cel7A. Binding of MaCel45A to lignin was dependent on pH in the presence and absence of the CBM; at high pH, less enzyme bound to isolated lignins. Potentiometric titration of the lignin preparations showed that negatively charged groups were present in the lignin samples and that negative charge in the samples was increased with increasing pH. The results suggest that electrostatic interactions contributed to non-productive enzyme adsorption: Reduced enzyme binding at high pH was presumably due to repulsive electrostatic interactions between the enzymes and lignin. The CBM increased binding of MaCel45A to the isolated lignins only at high pH. Hydrophobic interactions are probably involved in CBM binding to lignin, because the same aromatic amino acids that are essential in CBM-cellulose interaction were also shown to contribute to lignin-binding. ?? 2013 Elsevier Inc.},
  isbn = {1879-0909 (Electronic) 0141-0229 (Linking)},
  pmid = {24034430},
  keywords = {{Models, Molecular},{Mutagenesis, Site-Directed},Adsorption,Catalytic Domain,CBM,Cellulase,Cellulose,Electrostatic interaction,EnzHR,enzymatic hydrolysis residue,Hydrogen-Ion Concentration,Hydrolysis,Hydrophobic and Hydrophilic Interactions,Lignin,Lignocellulose,MaCel45A,MCC,Melanocarpus albomyces Cel45A,microcrystalline cellulose,Models Molecular,Mutagenesis Site-Directed,Non-productive binding,Recombinant Proteins,Sordariales,Static Electricity,TrCel7A,Trichoderma,Trichoderma reesei Cel7A}
}
