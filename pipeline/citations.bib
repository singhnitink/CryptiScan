@article{Quinlan2011,
  title = {Insights into the Oxidative Degradation of Cellulose by a Copper Metalloenzyme That Exploits Biomass Components},
  author = {Quinlan, R J and Sweeney, M D and Lo Leggio, L and Otten, H and Poulsen, J C N and Johansen, K S and Krogh, Kbrm and Jorgensen, C I and Tovborg, M and Anthonsen, A and Tryfona, T and Walter, C P and Dupree, P and Xu, F and Davies, G J and Walton, P H},
  year = 2011,
  journal = {Proc. Natl. Acad. Sci. U. S. A.},
  volume = {108},
  number = {37},
  pages = {15079--15084},
  doi = {10.1073/pnas.1105776108},
  abstract = {The enzymatic degradation of recalcitrant plant biomass is one of the key industrial challenges of the 21st century. Accordingly, there is a continuing drive to discover new routes to promote polysaccharide degradation. Perhaps the most promising approach involves the application of "cellulase-enhancing factors," such as those from the glycoside hydrolase (CAZy) GH61 family. Here we show that GH61 enzymes are a unique family of copper-dependent oxidases. We demonstrate that copper is needed for GH61 maximal activity and that the formation of cellodextrin and oxidized cellodextrin products by GH61 is enhanced in the presence of small molecule redox-active cofactors such as ascorbate and gallate. By using electron paramagnetic resonance spectroscopy and single-crystal X-ray diffraction, the active site of GH61 is revealed to contain a type II copper and, uniquely, a methylated histidine in the copper's coordination sphere, thus providing an innovative paradigm in bioinorganic enzymatic catalysis.},
  isbn = {0027-8424},
  langid = {english},
  pmcid = {PMC3174640},
  pmid = {21876164},
  keywords = {{Models, Molecular},{Spectrometry, Mass, Matrix-Assisted Laser Desorption-Ionization},Biocatalysis,bioethanol,Biomass,Catalytic Domain,cellulase,Cellulose,chemistry,Copper,corn stover,Electron Spin Resonance Spectroscopy,enzymatic conversion,glycoside hydrolase family,Glycoside Hydrolases,Histidine,hydrolysis,Ions,lignocellulose,Metalloproteins,Methylation,Models Molecular,molecular-graphics,Oxidation-Reduction,Phosphoric Acids,plant cell wall,polysaccharides,posttranslational modification,pretreatment,Spectrometry Mass Matrix-Assisted Laser Desorption-Ionization,Thermoascus,wood}
}
