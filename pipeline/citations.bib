@article{Shi2026,
  title = {Lipid {{Membrane Regulation}} of {{Chlorophyll Triplet Excitation Quenching}} in {{Photosynthetic Light-Harvesting Complex LHCII}}},
  author = {Shi, Yan-Ping and Gao, Rong-Yao and Wang, Hao-Yi and Zou, Jian-Wei and Yamano, Nami and Dong, Feng-Qin and Zheng, Junrong and Zhang, Jian-Ping},
  year = 2026,
