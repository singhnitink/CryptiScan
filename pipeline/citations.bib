@article{Sugiyama1985,
  title = {Lattice Images from Ultrathin Sections of Cellulose Microfibrils in the Cell Wall of {{Valonia}} Macrophysa {{K\"utz}}.},
  author = {Sugiyama, J. and Harada, H. and Fujiyoshi, Y. and Uyeda, N.},
