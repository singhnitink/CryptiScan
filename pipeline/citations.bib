@article{Addison2024,
  title = {Atomistic, Macromolecular Model of the {{{\emph{Populus}}}} Secondary Cell Wall Informed by Solid-State {{NMR}}},
  author = {Addison, Bennett and Bu, Lintao and Bharadwaj, Vivek and Crowley, Meagan F. and {Harman-Ware}, Anne E. and Crowley, Michael F. and Bomble, Yannick J. and Ciesielski, Peter N.},
  year = 2024,
