@article{Best1999,
  title = {Free {{Energy Perturbation Study}} of {{Octanol}}/{{Water Partition Coefficients}}:  {{Comparison}} with {{Continuum GB}}/{{SA Calculations}}},
  author = {Best, Scott A. and Merz, Kenneth M. and Reynolds, Charles H.},
