  keywords = {{Receptors, Autocrine Motility Factor},Autophagy,Computational models,Endoplasmic reticulum,Endoplasmic Reticulum,Endoplasmic Reticulum Stress,Intracellular Signaling Peptides and Proteins,Microtubule-Associated Proteins,Receptors Autocrine Motility Factor,Ubiquitination,Ubiquitins,Ubiquitylation}
