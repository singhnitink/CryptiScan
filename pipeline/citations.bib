@article{Kagan2009,
  title = {Cytochrome c/Cardiolipin Relations in Mitochondria: A Kiss of Death.},
  author = {Kagan, Valerian E and Bayir, H{\"u}lya A and Belikova, Natalia A and Kapralov, Olexandr and Tyurina, Yulia Y and Tyurin, Vladimir A and Jiang, Jianfei and Stoyanovsky, Detcho A and Wipf, Peter and Kochanek, Patrick M and Greenberger, Joel S and Pitt, Bruce and Shvedova, Anna A and Borisenko, Grigory},
