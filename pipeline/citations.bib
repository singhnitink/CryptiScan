@article{Smigiel2022,
  title = {Protein Diffusion in {{{\emph{Escherichia}}}}{\emph{ Coli}} Cytoplasm Scales with the Mass of the Complexes and Is Location Dependent},
  author = {{\'S}migiel, Wojciech M. and Mantovanelli, Luca and Linnik, Dmitrii S. and Punter, Michiel and Silberberg, Jakob and Xiang, Limin and Xu, Ke and Poolman, Bert},
  year = 2022,
  month = aug,
  journal = {Sci. Adv.},
  volume = {8},
  number = {32},
  pages = {eabo5387},
  issn = {2375-2548},
  doi = {10.1126/sciadv.abo5387},
  urldate = {2025-06-11},
  abstract = {We analyze the structure of the cytoplasm by performing single-molecule displacement mapping on a diverse set of native cytoplasmic proteins in exponentially growing               Escherichia coli               . We evaluate the method for application in small compartments and find that confining effects of the cell membrane affect the diffusion maps. Our analysis reveals that protein diffusion at the poles is consistently slower than in the center of the cell, i.e., to an extent greater than the confining effect of the cell membrane. We also show that the diffusion coefficient scales with the mass of the used probes, taking into account the oligomeric state of the proteins, while parameters such as native protein abundance or the number of protein-protein interactions do not correlate with the mobility of the proteins. We argue that our data paint the prokaryotic cytoplasm as a compartment with subdomains in which the diffusion of macromolecules changes with the perceived viscosity.                        ,              Native protein diffusion highlights heterogeneities in the bacterial cytoplasm.},
  langid = {english},
  pmcid = {PMC9374337},
  pmid = {35960807},
  keywords = {Cell Membrane,Cytoplasm,Diffusion,Escherichia coli,Escherichia coli Proteins}
}
