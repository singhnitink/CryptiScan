  author = {Ragauskas, A J and Williams, C K and Davison, B H and Britovsek, G and Cairney, J and Eckert, C A and Frederick, W J and Hallett, J P and Leak, D J and Liotta, C L and Mielenz, J R and Murphy, R and Templer, R and Tschaplinski, T},
