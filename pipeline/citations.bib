  author = {Tosatto, Laura and Andrighetti, Alberto O and Plotegher, Nicoletta and Antonini, Valeria and Tessari, Isabella and Ricci, Leonardo and Bubacco, Luigi and Dalla Serra, Mauro},
  year = 2012,
