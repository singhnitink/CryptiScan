  keywords = {{Microscopy, Electron, Scanning},{Spectroscopy, Fourier Transform Infrared},Biofuels,Biomass,Cellulase,Ethanol,Fermentation,Hot Temperature,Hydrolysis,Lignin,Microscopy Electron Scanning,Porosity,Spectroscopy Fourier Transform Infrared,X-Ray Diffraction}
}
