@article{Vermaas2019c,
  title = {The Dissociation Mechanism of Processive Cellulases},
  author = {Vermaas, Josh V. and Kont, Riin and Beckham, Gregg T. and Crowley, Michael F. and Gudmundsson, Mikael and Sandgren, Mats and St{\aa}hlberg, Jerry and V{\"a}ljam{\"a}e, Priit and Knott, Brandon C.},
