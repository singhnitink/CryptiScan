@article{Biology2008,
  title = {Tree-Based Position Weight Matrix Approach to Model Transcription Factor Binding Site Profiles.},
  author = {Bi, Yingtao and Kim, Hyunsoo and Gupta, Ravi and Davuluri, Ramana V},
