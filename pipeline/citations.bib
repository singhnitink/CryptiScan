@article{Medie2012,
  title = {Genome Analyses Highlight the Different Biological Roles of Cellulases},
  author = {Medie, Felix Mba and Davies, Gideon J and Drancourt, Michel and Henrissat, Bernard},
  year = 2012,
  month = jan,
  journal = {Nat. Rev. Microbiol.},
  volume = {10},
  number = {3},
  eprint = {22266780},
  eprinttype = {pubmed},
  pages = {227--234},
  issn = {1740-1526},
  doi = {10.1038/nrmicro2729},
  urldate = {2014-11-17},
  abstract = {Cellulolytic enzymes have been the subject of renewed interest owing to their potential role in the conversion of plant lignocellulose to sustainable biofuels. An analysis of {$\sim$}1,500 complete bacterial genomes, presented here, reveals that {$\sim$}40\% of the genomes of sequenced bacteria encode at least one cellulase gene. Most of the bacteria that encode cellulases are soil and marine saprophytes, many of which encode a range of enzymes for cellulose hydrolysis and also for the breakdown of the other constituents of plant cell walls (hemicelluloses and pectins). Intriguingly, cellulases are present in organisms that are usually considered as non-saprophytic, such as Mycobacterium tuberculosis, Legionella pneumophila, Yersinia pestis and even Escherichia coli. We also discuss newly emerging roles of cellulases in such non-saprophytic organisms.},
  isbn = {1740-1526},
