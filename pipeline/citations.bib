@article{Morrison2014,
  title = {Transported {{Substrate Determines Exchange Rate}} in the {{Multidrug Resistance Transporter EmrE}}},
  author = {Morrison, Emma A and {Henzler-Wildman}, Katherine A},
  year = 2014,
  month = mar,
  journal = {J. Biol. Chem.},
  volume = {289},
  number = {10},
  eprint = {24448799},
  eprinttype = {pubmed},
  pages = {6825--6836},
  issn = {0021-9258},
  doi = {10.1074/jbc.M113.535328},
  urldate = {2014-09-08},
  abstract = {EmrE, a small multidrug resistance transporter, serves as an ideal model to study coupling between multidrug recognition and protein function. EmrE has a single small binding pocket that must accommodate the full range of diverse substrates recognized by this transporter. We have studied a series of tetrahedral compounds, as well as several planar substrates, to examine multidrug recognition and transport by EmrE. Here we show that even within this limited series, the rate of interconversion between the inward- and outward-facing states of EmrE varies over 3 orders of magnitude. Thus, the identity of the bound substrate controls the rate of this critical step in the transport process. The binding affinity also varies over a similar range and is correlated with substrate hydrophobicity within the tetrahedral substrate series. Substrate identity influences both the ground-state and transition-state energies for the conformational exchange process, highlighting the coupling between substrate binding and transport required for alternating access antiport.},
  pmcid = {PMC3945343},
  pmid = {24448799},
  keywords = {{Drug Resistance, Multiple, Bacterial},{Nuclear Magnetic Resonance, Biomolecular},{Protein Structure, Secondary},Antiporters,Antiporters: chemistry,Antiporters: genetics,Antiporters: metabolism,Bacterial,Biological Transport,Biomolecular,Cell Membrane,Cell Membrane: chemistry,Cell Membrane: metabolism,Drug Resistance,Drug Resistance Multiple Bacterial,Escherichia coli,Escherichia coli Proteins,Escherichia coli Proteins: chemistry,Escherichia coli Proteins: genetics,Escherichia coli Proteins: metabolism,Escherichia coli: drug effects,Escherichia coli: genetics,Escherichia coli: metabolism,Kinetics,Ligands,Membrane Transport,Multidrug Transporters,Multiple,NMR,Nuclear Magnetic Resonance,Nuclear Magnetic Resonance Biomolecular,Protein Binding,Protein Drug Interactions,Protein Dynamics,Protein Structure,Protein Structure Secondary,Secondary,Substrate Specificity}
