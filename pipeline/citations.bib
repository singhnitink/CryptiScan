@article{Vanommeslaeghe2010,
  title = {{{CHARMM}} General Force Field: {{A}} Force Field for Drug-like Molecules Compatible with the {{CHARMM}} All-atom Additive Biological Force Fields},
  shorttitle = {{{CHARMM}} General Force Field},
  author = {Vanommeslaeghe, K. and Hatcher, E. and Acharya, C. and Kundu, S. and Zhong, S. and Shim, J. and Darian, E. and Guvench, O. and Lopes, P. and Vorobyov, I. and Mackerell, A. D.},
  year = 2010,
  month = mar,
  journal = {J Comput Chem},
  volume = {31},
  number = {4},
  eprint = {19575467},
  eprinttype = {pmid},
  pages = {671--690},
  publisher = {Wiley Subscription Services, Inc., A Wiley Company},
  issn = {0192-8651, 1096-987X},
  doi = {10.1002/jcc.21367},
  urldate = {2025-06-10},
  abstract = {Abstract             The widely used CHARMM additive all-atom force field includes parameters for proteins, nucleic acids, lipids, and carbohydrates. In the present article, an extension of the CHARMM force field to drug-like molecules is presented. The resulting CHARMM General Force Field (CGenFF) covers a wide range of chemical groups present in biomolecules and drug-like molecules, including a large number of heterocyclic scaffolds. The parametrization philosophy behind the force field focuses on quality at the expense of transferability, with the implementation concentrating on an extensible force field. Statistics related to the quality of the parametrization with a focus on experimental validation are presented. Additionally, the parametrization procedure, described fully in the present article in the context of the model systems, pyrrolidine, and 3-phenoxymethylpyrrolidine will allow users to readily extend the force field to chemical groups that are not explicitly covered in the force field as well as add functional groups to and link together molecules already available in the force field. CGenFF thus makes it possible to perform ``all-CHARMM'' simulations on drug-target interactions thereby extending the utility of CHARMM force fields to medicinally relevant systems. \copyright{} 2009 Wiley Periodicals, Inc. J Comput Chem, 2010},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  isbn = {1096-987X},
  langid = {english},
  pmcid = {PMC2888302},
  pmid = {19575467},
  keywords = {{Models, Chemical},{Models, Molecular},Chemical,Computational chemistry,Computer aided drug design,Computer Simulation,Drug design,Empirical force field,Medicinal chemistry,Models,Models Chemical,Models Molecular,Molecular,Molecular dynamics,Molecular Dynamics Simulation,Molecular modeling,Pyrrolidines,Pyrrolidines: chemistry,Quantum Theory,Software}
}
