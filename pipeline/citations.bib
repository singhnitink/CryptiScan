@article{Maltsev2012,
  title = {Impact of {{N-terminal}} Acetylation of {{$\alpha$}}-Synuclein on Its Random Coil and Lipid Binding Properties.},
  author = {Maltsev, Alexander S and Ying, Jinfa and Bax, Ad},
  year = 2012,
  month = jun,
  journal = {Biochemistry},
  volume = {51},
  number = {25},
  pages = {5004--5013},
  publisher = {American Chemical Society},
  issn = {1520-4995},
  doi = {10.1021/bi300642h},
  urldate = {2013-04-03},
  abstract = {N-Terminal acetylation of {$\alpha$}-synuclein (aS), a protein implicated in the etiology of Parkinson's disease, is common in mammals. The impact of this modification on the protein's structure and dynamics in free solution and on its membrane binding properties has been evaluated by high-resolution nuclear magnetic resonance and circular dichroism (CD) spectroscopy. While no tetrameric form of acetylated aS could be isolated, N-terminal acetylation resulted in chemical shift perturbations of the first 12 residues of the protein that progressively decreased with the distance from the N-terminus. The directions of the chemical shift changes and small changes in backbone (3)J(HH) couplings are consistent with an increase in the {$\alpha$}-helicity of the first six residues of aS, although a high degree of dynamic conformational disorder remains and the helical structure is sampled {$<$}20\% of the time. Chemical shift and (3)J(HH) data for the intact protein are virtually indistinguishable from those recorded for the corresponding N-terminally acetylated and nonacetylated 15-residue synthetic peptides. An increase in {$\alpha$}-helicity at the N-terminus of aS is supported by CD data on the acetylated peptide and by weak medium-range nuclear Overhauser effect contacts indicative of {$\alpha$}-helical character. The remainder of the protein has chemical shift values that are very close to random coil values and indistinguishable between the two forms of the protein. No significant differences in the fibrillation kinetics were observed between acetylated and nonacetylated aS. However, the lipid binding properties of aS are strongly impacted by acetylation and exhibit distinct behavior for the first 12 residues, indicative of an initiation role for the N-terminal residues in an "initiation-elongation" process of binding to the membrane.},
  pmcid = {PMC3383124},
  pmid = {22694188},
  keywords = {{Protein Structure, Secondary},Acetylation,alpha-Synuclein,alpha-Synuclein: chemistry,alpha-Synuclein: metabolism,Binding Sites,Binding Sites: physiology,Humans,Membrane Lipids,Membrane Lipids: chemistry,Membrane Lipids: metabolism,Peptide Fragments,Peptide Fragments: chemistry,Peptide Fragments: metabolism,Protein Binding,Protein Binding: physiology,Protein Conformation,Protein Structure,Protein Structure Secondary,Secondary,Structure-Activity Relationship}
}

