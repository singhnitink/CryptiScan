@article{vandenBogaart2012,
  title = {Phosphatidylinositol 4,5-Bisphosphate Increases {{Ca2}}+ Affinity of Synaptotagmin-1 by 40-Fold.},
  author = {{van den Bogaart}, Geert and Meyenberg, Karsten and Diederichsen, Ulf and Jahn, Reinhard},
  year = 2012,
  month = may,
  journal = {J. Biol. Chem.},
  volume = {287},
  number = {20},
  pages = {16447--53},
  issn = {1083-351X},
  doi = {10.1074/jbc.M112.343418},
  urldate = {2014-11-07},
  abstract = {Synaptotagmin-1 is the main Ca(2+) sensor of neuronal exocytosis. It binds to both Ca(2+) and the anionic phospholipid phosphatidylinositol 4,5-bisphosphate (PIP(2)), but the precise cooperativity of this binding is still poorly understood. Here, we used microscale thermophoresis to quantify the cooperative binding of PIP(2) and Ca(2+) to synaptotagmin-1. We found that PIP(2) bound to the well conserved polybasic patch of the C2B domain with an apparent dissociation constant of {$\sim$}20 {$\mu$}M. PIP(2) binding reduced the apparent dissociation constant for Ca(2+) from {$\sim$}250 to {$<$}5 {$\mu$}M. Thus, our data show that PIP(2) makes synaptotagmin-1 {$>$}40-fold more sensitive to Ca(2+). This interplay between Ca(2+), synaptotagmin-1, and PIP(2) is crucial for neurotransmitter release.},
  pmcid = {PMC3351315},
  pmid = {22447935},
  keywords = {{Phosphatidylinositol 4,5-Diphosphate},{Protein Structure, Tertiary},5-Diphosphate,5-Diphosphate: chemistry,5-Diphosphate: metabolism,Animals,Calcium,Calcium: chemistry,Calcium: metabolism,Neurotransmitter Agents,Neurotransmitter Agents: secretion,Phosphatidylinositol 4,Phosphatidylinositol 45-Diphosphate,Protein Binding,Protein Structure,Protein Structure Tertiary,Rats,Synaptotagmin I,Synaptotagmin I: chemistry,Synaptotagmin I: genetics,Synaptotagmin I: metabolism,Tertiary}
