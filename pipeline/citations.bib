  pmid = {14691544},
  keywords = {{Crystallography, X-Ray},{Models, Molecular},{Protein Structure, Secondary},{Sequence Homology, Amino Acid},Amino Acid Sequence,Aquaporins,Carbon,Cell Membrane,CellModel,Crystallography X-Ray,Detergents,duplicate-citation-key,Escherichia coli,Escherichia coli Proteins,Glycerol,Hydrogen,Membrane Proteins,Models Molecular,Molecular Conformation,Molecular Sequence Data,Oxygen,Protein Binding,Protein Conformation,Protein Structure Secondary,Recombinant Proteins,Sequence Homology Amino Acid,Water}
}
