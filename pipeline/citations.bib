@article{Cerasoli2012,
  title = {Membrane Mediated Regulation in Free Peptides of {{HIV-1}} Gp41: {{Minimal}} Modulation of the Hemifusion Phase.},
  author = {Cerasoli, Eleonora and Ravi, Jascindra and Gregor, Craig and Hussain, Rohanah and Siligardi, Giuliano and Martyna, Glenn and Crain, Jason and Ryadnov, Maxim G},
  year = 2012,
