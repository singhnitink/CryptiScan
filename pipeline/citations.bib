@article{Ito2011a,
  title = {Tet {{Proteins Can Convert}} 5-{{Methylcytosine}} to 5-{{Formylcytosine}} and 5-{{Carboxylcytosine}}},
  author = {Ito, Shinsuke and Shen, Li and Dai, Qing and Wu, Susan C. and Collins, Leonard B. and Swenberg, James A. and He, Chuan and Zhang, Yi},
