@article{Roney2023,
  title = {Photon to Plate: {{A}} Holistic View of Photosynthetic and Anthropogenic Energy Fluxes},
  shorttitle = {Photon to Plate},
  author = {Roney, Heather E. and Walker, Berkley J.},
  year = 2023,
  month = jan,
  journal = {Food Energy Secur.},
  volume = {12},
  number = {1},
  pages = {e348},
  issn = {2048-3694, 2048-3694},
  doi = {10.1002/fes3.348},
  urldate = {2024-02-15},
  abstract = {Abstract Modern agriculture couples photosynthetic energy with human-applied energy supplements (e.g., fertilizers, labor, cultivation) to feed a growing population. These energy supplements usually come from fossil fuels, presenting an opportunity to decrease fossil fuel required per calorie by improving photosynthetic efficiency. To quantify how improving photosynthetic efficiency would decrease the supplemental energy needed per calorie, we present a ``photon to plate'' life cycle analysis of energy flows (photosynthetic and human-applied) needed to produce fresh-cut fries. Our results show that photosynthetic inefficiencies require \textasciitilde 80 times the energy used to cultivate, harvest, transport and prepare fries for consumption and that improvements to photosynthesis could reduce the energy applied by humans per calorie by almost 40\%. This study highlights the magnitude of energy used during photosynthesis and the potential for photosynthetic improvements to increase agricultural sustainability.},
  langid = {english}
}
