  title = {P-Glycoprotein Inhibition by Membrane Cholesterol Modulation.},
  author = {Fenyvesi, Ferenc and Fenyvesi, Eva and Szente, Lajos and Goda, Katalin and Bacs{\'o}, Zsolt and B{\'a}cskay, Ildik{\'o} and V{\'a}radi, Judit and Kiss, T{\'i}mea and Moln{\'a}r, Eva and Jan{\'a}ky, Tam{\'a}s and Szab{\'o}, G{\'a}bor and Vecserny{\'e}s, Mikl{\'o}s},
