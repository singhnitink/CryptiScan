@article{Villinger2010,
  title = {Functional Dynamics in the Voltage-Dependent Anion Channel.},
  author = {Villinger, Saskia and Briones, Rodolfo and Giller, Karin and Zachariae, Ulrich and Lange, Adam and {de Groot}, Bert L and Griesinger, Christian and Becker, Stefan and Zweckstetter, Markus},
  year = 2010,
  month = dec,
  journal = {Proc. Natl. Acad. Sci. U. S. A.},
  volume = {107},
  number = {52},
  pages = {22546--51},
  issn = {1091-6490},
  doi = {10.1073/pnas.1012310108},
  urldate = {2014-03-02},
  abstract = {The voltage-dependent anion channel (VDAC), located in the outer mitochondrial membrane, acts as a gatekeeper for the entry and exit of mitochondrial metabolites. Here we reveal functional dynamics of isoform one of VDAC (VDAC1) by a combination of solution NMR spectroscopy, Gaussian network model analysis, and molecular dynamics simulation. Micro- to millisecond dynamics are significantly increased for the N-terminal six {$\beta$}-strands of VDAC1 in micellar solution, in agreement with increased B-factors observed in the same region in the bicellar crystal structure of VDAC1. Molecular dynamics simulations reveal that a charge on the membrane-facing glutamic acid 73 (E73) accounts for the elevation of N-terminal protein dynamics as well as a thinning of the nearby membrane. Mutation or chemical modification of E73 strongly reduces the micro- to millisecond dynamics in solution. Because E73 is necessary for hexokinase-I-induced VDAC channel closure and inhibition of apoptosis, our results imply that micro- to millisecond dynamics in the N-terminal part of the barrel are essential for VDAC interaction and gating.},
  pmcid = {PMC3012482},
  pmid = {21148773},
