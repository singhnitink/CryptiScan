  pmid = {27916803},
  keywords = {{Biomarkers, Tumor},biomarkers,Biomarkers Tumor,cancer,diagnostic factors,Humans,Lipid Metabolism,lipidomics,Lipids,Prognosis,prognostic factors}
}
