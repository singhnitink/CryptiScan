@article{Rufener2005,
  title = {Membrane-Bound Orientation and Position of the Synaptotagmin {{C2B}} Domain Determined by Site-Directed Spin Labeling},
  author = {Rufener, Elisabeth and Frazier, April A. and Wieser, Catherine M. and Hinderliter, Anne and Cafiso, David S.},
  year = 2005,
  journal = {Biochemistry},
  volume = {44},
  pages = {18--28},
  issn = {0006-2960 (Print)\textbackslash n0006-2960 (Linking)},
  doi = {10.1021/bi048370d},
  abstract = {Site-directed spin labeling is used to determine the orientation and depth of insertion of the second C2 domain from synaptotagmin I (C2B) into membrane vesicles composed of phosphatidylcholine (PC) and phosphatidylserine (PS). EPR line shapes of spin-labeled mutants located with the Ca(2+)-binding loops of C2B broaden in the presence of Ca(2+) and PC/PS vesicles, indicating that these loops undergo a Ca(2+)-dependent insertion into the membrane interface. Power saturation of the EPR spectra provides a position for each spin-labeled site along the bilayer normal, and these EPR-derived distance constraints, along with a high-resolution structure of the C2B domain, are used to generate a model for the domain orientation and position at the membrane interface. Our data show that the isolated C2B domain from synaptotagmin I penetrates PC/PS membranes, and that the backbone of Ca(2+)-binding loops 1 and 3 is inserted below the level of a plane defined by the lipid phosphates. The side chains of several loop residues are within the bilayer interior, and both Ca(2+)-binding sites are positioned near a plane defined by the lipid phosphates. A Tb(3+)-based fluorescence assay is used to compare the membrane affinity of the C2B domain to that of the first synaptotagmin C2 domain (C2A). Both C2A and C2B bind PC/PS (75:25) membrane vesicles with a micromolar lipid affinity in the presence of metal ion. These results indicate that C2A and C2B have a similar membrane affinity and position when bound to PC/PS (75:25) membrane vesicles. EPR spectroscopy indicates that the C2B domain has different interactions with PC/PS membranes containing 1 mol \% phosphatidylinositol 4,5-bisphosphate.},
  isbn = {0006-2960 (Print)\textbackslash n0006-2960 (Linking)},
  pmid = {15628842},
  keywords = {{Models, Molecular},{Mutagenesis, Site-Directed},{Protein Structure, Secondary},{Spectrometry, Fluorescence},Animals,Binding Sites,Calcium-Binding Proteins,Electron Spin Resonance Spectroscopy,Kinetics,Liposomes,Membrane Glycoproteins,Models Molecular,Mutagenesis Site-Directed,Nerve Tissue Proteins,Phosphatidylcholines,Phosphatidylserines,Protein Structure Secondary,Rats,Recombinant Proteins,Spectrometry Fluorescence,Spin Labels,Synaptotagmin I,Synaptotagmins}
