@article{Zuzic2022,
  title = {Uncovering Cryptic Pockets in the {{SARS-CoV-2}} Spike Glycoprotein},
  author = {Zuzic, Lorena and Samsudin, Firdaus and Shivgan, Aishwary T. and Raghuvamsi, Palur V. and Marzinek, Jan K. and Boags, Alister and Pedebos, Conrado and Tulsian, Nikhil K. and Warwicker, Jim and MacAry, Paul and Crispin, Max and Khalid, Syma and Anand, Ganesh S. and Bond, Peter J.},
  year = 2022,
  journal = {Structure},
  volume = {30},
  number = {8},
  pages = {1062-1074.e4},
  issn = {0969-2126},
  doi = {10.1016/j.str.2022.05.006},
  abstract = {Summary The COVID-19 pandemic has prompted a rapid response in vaccine and drug development. Herein, we modeled a complete membrane-embedded SARS-CoV-2 spike glycoprotein and used molecular dynamics simulations with benzene probes designed to enhance discovery of cryptic pockets. This approach recapitulated lipid and host metabolite binding sites previously characterized by cryo-electron microscopy, revealing likely ligand entry routes, and uncovered a novel cryptic pocket with promising druggable properties located underneath the 617--628 loop. A full representation of glycan moieties was essential to accurately describe pocket dynamics. A multi-conformational behavior of the 617--628 loop in simulations was validated using hydrogen-deuterium exchange mass spectrometry experiments, supportive of opening and closing dynamics. The pocket is the site of multiple mutations associated with increased transmissibility found in SARS-CoV-2 variants of concern including Omicron. Collectively, this work highlights the utility of the benzene mapping approach in uncovering potential druggable sites on the surface of SARS-CoV-2 targets.},
  pmcid = {PMC9164293},
  pmid = {35660160},
  keywords = {{Spike Glycoprotein, Coronavirus},Benzene,benzene mapping,coronavirus,COVID-19,Cryoelectron Microscopy,cryptic pockets,glycans,hydrogen-deuterium exchange mass spectrometry,molecular dynamics simulation,Molecular Dynamics Simulation,omicron,Protein Binding,SARS-CoV-2,Spike Glycoprotein Coronavirus,spike protein}
}
