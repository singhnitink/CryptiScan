@article{Lloris-Garcera2013,
  title = {In Vivo Trp Scanning of the Small Multidrug Resistance Protein {{EmrE}} Confirms {{3D}} Structure Models'.},
  author = {{Lloris-Garcer{\'a}}, Pilar and Slusky, Joanna S G and Sepp{\"a}l{\"a}, Susanna and Prie{\ss}, Marten and Sch{\"a}fer, Lars V and {von Heijne}, Gunnar},
  year = 2013,
  month = nov,
  journal = {J. Mol. Biol.},
  volume = {425},
  number = {22},
  pages = {4642--51},
  issn = {1089-8638},
  doi = {10.1016/j.jmb.2013.07.039},
  urldate = {2014-08-08},
  abstract = {The quaternary structure of the homodimeric small multidrug resistance protein EmrE has been studied intensely over the past decade. Structural models derived from both two- and three-dimensional crystals show EmrE as an anti-parallel homodimer. However, the resolution of the structures is rather low and their relevance for the in vivo situation has been questioned. Here, we have challenged the available structural models by a comprehensive in vivo Trp scanning of all four transmembrane helices in EmrE. The results are in close agreement with the degree of lipid exposure of individual residues predicted from coarse-grained molecular dynamics simulations of the anti-parallel dimeric structure obtained by X-ray crystallography, strongly suggesting that the X-ray structure provides a good representation of the active in vivo form of EmrE.},
  pmid = {23920359},
  keywords = {{Crystallography, X-Ray},{Models, Molecular},{Mutagenesis, Site-Directed},Amino Acid Sequence,Antiporters,Antiporters: chemistry,Antiporters: genetics,Antiporters: metabolism,blue-native PAGE,BN-PAGE,CG,coarse-grained,Crystallography,Crystallography X-Ray,dimyristoylphosphatidylcholine,DMPC,EmrE,Escherichia coli Proteins,Escherichia coli Proteins: chemistry,Escherichia coli Proteins: genetics,Escherichia coli Proteins: metabolism,MD,Models,Models Molecular,Molecular,molecular dynamics,Molecular Sequence Data,multidrug resistance,Mutagenesis,Mutagenesis Site-Directed,Position-Specific Scoring Matrices,Protein Conformation,Protein Multimerization,Site-Directed,tetraphenylphosphonium,TMH,TPP,transmembrane helix,Trp scan,X-Ray}
}
