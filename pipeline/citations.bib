@article{Mavelli2014,
  title = {The Binding of Quinone to the Photosynthetic Reaction Centers: {{Kinetics}} and Thermodynamics of Reactions Occurring at the Qb-Site in Zwitterionic and Anionic Liposomes},
  author = {Mavelli, Fabio and Trotta, Massimo and Ciriaco, Fulvio and Agostiano, Angela and Giotta, Livia and Italiano, Francesca and Milano, Francesco},
  year = 2014,
  month = jul,
  journal = {Eur. Biophys. J.},
  volume = {43},
  number = {6-7},
  eprint = {24824111},
  eprinttype = {pubmed},
  pages = {301--315},
  issn = {14321017},
  doi = {10.1007/s00249-014-0963-z},
  urldate = {2014-10-24},
  abstract = {Liposomes represent a versatile biomimetic environment for studying the interaction between integral membrane proteins and hydrophobic ligands. In this paper, the quinone binding to the Q\textasciicircum sub B\textasciicircum -site of the photosynthetic reaction centers (RC) from Rhodobacter sphaeroides has been investigated in liposomes prepared with either the zwitterionic phosphatidylcholine (PC) or the negatively charged phosphatidylglycerol (PG) to highlight the role of the different phospholipid polar heads. Quinone binding (K \textasciicircum sub Q\textasciicircum ) and interquinone electron transfer (L \textasciicircum sub AB\textasciicircum ) equilibrium constants in the two type of liposomes were obtained by charge recombination reaction of Q\textasciicircum sub B\textasciicircum -depleted RC in the presence of increasing amounts of ubiquinone-10 over the temperature interval 6-35 {$^\circ$}C. The kinetic of the charge recombination reactions has been fitted by numerically solving the ordinary differential equations set associated with a detailed kinetic scheme involving electron transfer reactions coupled with quinone release and uptake. The entire set of traces at each temperature was accurately fitted using the sole quinone release constants (both in a neutral and a charge separated state) as adjustable parameters. The temperature dependence of the quinone exchange rate at the Q\textasciicircum sub B\textasciicircum -site was, hence, obtained. It was found that the quinone exchange regime was always fast for PC while it switched from slow to fast in PG as the temperature rose above 20 {$^\circ$}C. A new method was introduced in this paper for the evaluation of constant K \textasciicircum sub Q\textasciicircum{} using the area underneath the charge recombination traces as the indicator of the amount of quinone bound to the Q\textasciicircum sub B\textasciicircum -site.[PUBLICATION ABSTRACT]},
  pmid = {24824111},
  keywords = {{Models, Biological},Bacterial photosynthesis,Kinetics,Ligand binding,Liposomes,Models Biological,Phosphatidylcholines,Phosphatidylglycerols,Photosynthetic Reaction Center Complex Proteins,Protein Binding,Protein-lipid interaction,Quinones,Rhodobacter sphaeroides,Temperature,Thermodynamics}
}
