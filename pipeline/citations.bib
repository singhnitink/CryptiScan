@article{Qi2015a,
  title = {{{CHARMM-GUI HMMM Builder}} for {{Membrane Simulations}} with the {{Highly Mobile Membrane-Mimetic Model}}},
  author = {Qi, Yifei and Cheng, Xi and Lee, Jumin and Vermaas, Josh V. and Pogorelov, Taras V. and Tajkhorshid, Emad and Park, Soohyung and Klauda, Jeffery B. and Im, Wonpil},
