@article{Gil-Ley2015,
  title = {Enhanced Conformational Sampling Using Replica Exchange with Collective-Variable Tempering},
  author = {{Gil-Ley}, Alejandro and Bussi, Giovanni},
  year = 2015,
  month = mar,
  journal = {J. Chem. Theory Comput.},
  volume = {11},
  number = {3},
