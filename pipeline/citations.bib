@article{Gudheti2013,
  title = {Actin Mediates the Nanoscale Membrane Organization of the Clustered Membrane Protein Influenza Hemagglutinin},
  author = {Gudheti, Manasa V. and Curthoys, Nikki M. and Gould, Travis J. and Kim, Dahan and Gunewardene, Mudalige S. and Gabor, Kristin A. and Gosse, Julie A. and Kim, Carol H. and Zimmerberg, Joshua and Hess, Samuel T.},
  year = 2013,
