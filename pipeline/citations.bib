@article{Zheng2011a,
  title = {Disruption of {{Chlorella}} Vulgaris {{Cells}} for the {{Release}} of {{Biodiesel-Producing Lipids}}: {{A Comparison}} of {{Grinding}}, {{Ultrasonication}}, {{Bead Milling}}, {{Enzymatic Lysis}}, and {{Microwaves}}},
  shorttitle = {Disruption of {{Chlorella}} Vulgaris {{Cells}} for the {{Release}} of {{Biodiesel-Producing Lipids}}},
  author = {Zheng, Hongli and Yin, Jilong and Gao, Zhen and Huang, He and Ji, Xiaojun and Dou, Chang},
  year = 2011,
  month = aug,
  journal = {Appl. Biochem. Biotechnol.},
  volume = {164},
  number = {7},
  pages = {1215--1224},
  issn = {0273-2289, 1559-0291},
  doi = {10.1007/s12010-011-9207-1},
  urldate = {2017-03-21},
  abstract = {A comparative evaluation of different cell disruption methods for the release of lipids from marine Chlorella vulgaris cells was investigated. The cell growth of C. vulgaris was observed. Lipid concentrations from different disruption methods were determined, and the fatty acid composition of the extracted lipids was analyzed. The results showed that average productivity of C. vulgaris biomass was 208 mg L{$^{-1}$} day{$^{-1}$}. The lipid concentrations of C. vulgaris were 5\%, 6\%, 29\%, 15\%, 10\%, 7\%, 22\%, 24\%, and 18\% when using grinding with quartz sand under wet condition, grinding with quartz sand under dehydrated condition, grinding in liquid nitrogen, ultrasonication, bead milling, enzymatic lysis by snailase, enzymatic lysis by lysozyme, enzymatic lysis by cellulose, and microwaves, respectively. The shortest disruption time was 2 min by grinding in liquid nitrogen. The unsaturated and saturated fatty acid contents of C. vulgaris were 71.76\% and 28.24\%, respectively. The extracted lipids displayed a suitable fatty acid profile for biodiesel [C16:0 (\textasciitilde 23\%), C16:1 (\textasciitilde 23\%), and C18:1 (\textasciitilde 45\%)]. Overall, grinding in liquid nitrogen was identified as the most effective method in terms of disruption efficiency and time.},
  isbn = {02732289},
  langid = {english},
  pmid = {21347653},
  keywords = {{Fatty Acids, Unsaturated},Biofuels,Biomass,Biotechnology,Cell disruption,Cellulase,Chlorella vulgaris,Cold Temperature,Desiccation,duplicate-citation-key,Fatty Acids,Fatty Acids Unsaturated,Hydrolysis,Lipid concentration,Microalga,Microwaves,Muramidase,Nitrogen,Sonication,Wettability}
}
