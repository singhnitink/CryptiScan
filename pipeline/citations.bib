@article{Schnorr1979,
  title = {{[Diagnostics and therapy of the carcinoma of the prostate (author's transl)].}},
  author = {Schnorr, D. and Guddat, H. M. and Neuser, D. and Correns, H. J. and D{\"o}rner, G. and Mau, S.},
