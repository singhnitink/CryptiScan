@article{Park2003,
  title = {Free Energy Calculation from Steered Molecular Dynamics Simulations Using {{Jarzynski}}'s Equality},
  author = {Park, Sanghyun and {Khalili-Araghi}, Fatemeh and Tajkhorshid, Emad and Schulten, Klaus},
  year = 2003,
