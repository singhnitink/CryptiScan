@article{Suga2019,
  title = {Structure of the Green Algal Photosystem {{I}} Supercomplex with a Decameric Light-Harvesting Complex {{I}}},
  author = {Suga, Michihiro and Ozawa, Shin-Ichiro and {Yoshida-Motomura}, Kaori and Akita, Fusamichi and Miyazaki, Naoyuki and Takahashi, Yuichiro},
