@article{Hill2009,
  title = {Decay Resistance of Acetylated and Hexanoylated Hardwood and Softwood Species Exposed to {{{\emph{Coniophora}}}}{\emph{ Puteana}}},
  author = {Hill, Callum A.S. and Curling, Simon F. and Kwon, Jin H. and Marty, Virginie},
