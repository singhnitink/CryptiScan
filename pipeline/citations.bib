@article{Bartels2010,
  title = {The {{N-terminus}} of the Intrinsically Disordered Protein {{$\alpha$}}-Synuclein Triggers Membrane Binding and Helix Folding.},
  author = {Bartels, Tim and Ahlstrom, Logan S and Leftin, Avigdor and Kamp, Frits and Haass, Christian and Brown, Michael F and Beyer, Klaus},
