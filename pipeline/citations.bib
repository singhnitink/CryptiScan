@article{Leszczyszyn2022,
  title = {The {{Future}} of {{Wood Construction}}: {{Opportunities}} and {{Barriers Based}} on {{Surveys}} in {{Europe}} and {{Chile}}},
  shorttitle = {The {{Future}} of {{Wood Construction}}},
  author = {Leszczyszyn, Ewa and Her{\"a}j{\"a}rvi, Henrik and Verkasalo, Erkki and {Garcia-Jaca}, Javier and {Araya-Letelier}, Gerardo and Lanvin, Jean-Denis and Bidzi{\'n}ska, Gabriela and {Augustyniak-Wysocka}, Dobrochna and Kies, Uwe and Calvillo, Alex and Wahlstr{\"o}mh, Margareta and Kouyoumji, Jean-Luc},
  year = 2022,
  month = apr,
  journal = {Sustainability},
  volume = {14},
  number = {7},
  pages = {4358},
  issn = {2071-1050},
  doi = {10.3390/su14074358},
  urldate = {2024-11-18},
  abstract = {The demand for wood has increased in recent years due to new technical possibilities and environmental concerns. This paper provides an analysis of the factors that affect the use of wood in the construction sector, and an assessment of their importance in individual countries and for groups of stakeholders. The study covers the technical, societal, political, economic, and gender aspects of wood construction, with the aim of increasing global understanding regarding national differences, the current situation, and the potential for further development. The subject was investigated using a survey, and the most important opportunities for and barriers to growth in the use of wood in the construction sector were selected, following a statistical analysis. The results indicate strong regional and cultural differences regarding the acceptance of some of the opportunities and barriers related to the development of wood construction. The findings indicate that there is a need to promote wood construction based on its technical and economic benefits rather than its societal ones. On the other hand, the current societal barriers should be addressed as a priority, together with the establishment of common and harmonized policies. The results of this study, therefore, will contribute to the generation of regional-sensitive information that can be useful for policymakers when updating the building codes in their individual countries.},
  langid = {english}
}
