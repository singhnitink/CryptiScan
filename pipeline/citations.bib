@article{Perrotti2016,
  title = {Advances in {{Lipidomics}} for {{Cancer Biomarkers Discovery}}},
  author = {Perrotti, Francesca and Rosa, Consuelo and Cicalini, Ilaria and Sacchetta, Paolo and Del Boccio, Piero and Genovesi, Domenico and Pieragostino, Damiana},
  year = 2016,
