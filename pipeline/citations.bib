@article{Foyer2012,
  title = {Photosynthetic Control of Electron Transport and the Regulation of Gene Expression.},
  author = {Foyer, Christine H and Neukermans, Jenny and Queval, Guillaume and Noctor, Graham and Harbinson, Jeremy},
  year = 2012,
  month = feb,
  journal = {J. Exp. Bot.},
  volume = {63},
  number = {4},
  pages = {1637--61},
  issn = {1460-2431},
  doi = {10.1093/jxb/ers013},
  urldate = {2013-08-09},
  abstract = {The term 'photosynthetic control' describes the short- and long-term mechanisms that regulate reactions in the photosynthetic electron transport (PET) chain so that the rate of production of ATP and NADPH is coordinated with the rate of their utilization in metabolism. At low irradiances these mechanisms serve to optimize light use efficiency, while at high irradiances they operate to dissipate excess excitation energy as heat. Similarly, the production of ATP and NADPH in ratios tailored to meet demand is finely tuned by a sophisticated series of controls that prevents the accumulation of high NAD(P)H/NAD(P) ratios and ATP/ADP ratios that would lead to potentially harmful over-reduction and inactivation of PET chain components. In recent years, photosynthetic control has also been extrapolated to the regulation of gene expression because mechanisms that are identical or similar to those that serve to regulate electron flow through the PET chain also coordinate the regulated expression of genes encoding photosynthetic proteins. This requires coordinated gene expression in the chloroplasts, mitochondria, and nuclei, involving complex networks of forward and retrograde signalling pathways. Photosynthetic control operates to control photosynthetic gene expression in response to environmental and metabolic changes. Mining literature data on transcriptome profiles of C(3) and C(4) leaves from plants grown under high atmospheric carbon dioxide (CO(2)) levels compared with those grown with ambient CO(2) reveals that the transition to higher photorespiratory conditions in C(3) plants enhances the expression of genes associated with cyclic electron flow pathways in Arabidopsis thaliana, consistent with the higher ATP requirement (relative to NADPH) of photorespiration.},
  pmid = {22371324},
  keywords = {{Gene Expression Regulation, Plant},Arabidopsis,Arabidopsis: genetics,Arabidopsis: metabolism,Electron Transport,Gene Expression Regulation Plant,Light,Photosynthesis,Photosynthesis: physiology,Photosynthetic Reaction Center Complex Proteins,Photosynthetic Reaction Center Complex Proteins: g,Photosynthetic Reaction Center Complex Proteins: m}
}
