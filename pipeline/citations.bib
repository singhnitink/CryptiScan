@article{Wiedmann2017,
  title = {Development of {{Cell-Permeable}}, {{Non-Helical Constrained Peptides}} to {{Target}} a {{Key Protein}}--{{Protein Interaction}} in {{Ovarian Cancer}}},
  author = {Wiedmann, Mareike M. and Tan, Yaw Sing and Wu, Yuteng and Aibara, Shintaro and Xu, Wenshu and Sore, Hannah F. and Verma, Chandra S. and Itzhaki, Laura and Stewart, Murray and Brenton, James D. and Spring, David R.},
  year = 2017,
