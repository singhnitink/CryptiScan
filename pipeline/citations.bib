@article{Phillips2011,
  title = {Cellobiose {{Dehydrogenase}} and a {{Copper-Dependent Polysaccharide Monooxygenase Potentiate Cellulose Degradation}} by {{Neurospora}} Crassa},
  author = {Phillips, Christopher M and Beeson, William T and Cate, Jamie H and Marletta, Michael A},
  year = 2011,
