@article{Hormoz2011,
  title = {Design Principles for Self-Assembly with Short-Range Interactions},
  author = {Hormoz, Sahand and Brenner, Michael P.},
  year = 2011,
  month = mar,
  journal = {Proc. Natl. Acad. Sci. U.S.A.},
  volume = {108},
