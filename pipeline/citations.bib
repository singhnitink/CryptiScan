@article{Diao2013,
  title = {Native {{$\alpha$}}-Synuclein Induces Clustering of Synaptic-Vesicle Mimics via Binding to Phospholipids and Synaptobrevin-2/{{VAMP2}}.},
  author = {Diao, Jiajie and Burr{\'e}, Jacqueline and Vivona, Sandro and Cipriano, Daniel J and Sharma, Manu and Kyoung, Minjoung and S{\"u}dhof, Thomas C and Brunger, Axel T},
  year = 2013,
  month = jan,
  journal = {eLife},
  volume = {2},
  pages = {e00592},
  issn = {2050-084X},
  doi = {10.7554/eLife.00592},
  urldate = {2014-04-28},
  abstract = {{$\alpha$}-Synuclein is a presynaptic protein that is implicated in Parkinson's and other neurodegenerative diseases. Physiologically, native {$\alpha$}-synuclein promotes presynaptic SNARE-complex assembly, but its molecular mechanism of action remains unknown. Here, we found that native {$\alpha$}-synuclein promotes clustering of synaptic-vesicle mimics, using a single-vesicle optical microscopy system. This vesicle-clustering activity was observed for both recombinant and native {$\alpha$}-synuclein purified from mouse brain. Clustering was dependent on specific interactions of native {$\alpha$}-synuclein with both synaptobrevin-2/VAMP2 and anionic lipids. Out of the three familial Parkinson's disease-related point mutants of {$\alpha$}-synuclein, only the lipid-binding deficient mutation A30P disrupted clustering, hinting at a possible loss of function phenotype for this mutant. {$\alpha$}-Synuclein had little effect on Ca(2+)-triggered fusion in our reconstituted single-vesicle system, consistent with in vivo data. {$\alpha$}-Synuclein may therefore lead to accumulation of synaptic vesicles at the active zone, providing a 'buffer' of synaptic vesicles, without affecting neurotransmitter release itself. DOI:http://dx.doi.org/10.7554/eLife.00592.001.},
  pmcid = {PMC3639508},
  pmid = {23638301},
  keywords = {{Adaptor Proteins, Vesicular Transport},Adaptor Proteins Vesicular Transport,alpha-synuclein,alpha-Synuclein,Animals,Brain,Mice,Molecular Mimicry,Mouse,Nerve Tissue Proteins,Parkinson's disease,Phospholipids,synaptic terminals,Synaptic Vesicles,Synaptotagmin I,Vesicle-Associated Membrane Protein 2}
}

