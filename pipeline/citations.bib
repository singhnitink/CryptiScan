@article{Liu2014b,
  title = {Structure and Mechanism of an Intramembrane Liponucleotide Synthetase Central for Phospholipid Biosynthesis.},
  author = {Liu, Xiuying and Yin, Yan and Wu, Jinjun and Liu, Zhenfeng},
  year = 2014,
  month = jun,
  journal = {Nat. Commun.},
  volume = {5},
  number = {May},
  pages = {4244},
  issn = {2041-1723},
  doi = {10.1038/ncomms5244},
  urldate = {2016-10-20},
  abstract = {Phospholipids are elemental building-block molecules for biological membranes. Biosynthesis of phosphatidylinositol, phosphatidylglycerol and phosphatidylserine requires a central liponucleotide intermediate named cytidine-diphosphate diacylglycerol (CDP-DAG). The CDP-DAG synthetase (Cds) is an integral membrane enzyme catalysing the formation of CDP-DAG, an essential step for phosphoinositide recycling during signal transduction. Here we report the structure of the Cds from Thermotoga maritima (TmCdsA) at 3.4 \AA{} resolution. TmCdsA forms a homodimer and each monomer contains nine transmembrane helices arranged into a novel fold with three domains. An unusual funnel-shaped cavity penetrates half way into the membrane, allowing the enzyme to simultaneously accept hydrophilic substrate (cytidine 5'-triphosphate (CTP)/deoxy-CTP) from cytoplasm and hydrophobic substrate (phosphatidic acid) from membrane. Located at the bottom of the cavity, a Mg(2+)-K(+) hetero-di-metal centre coordinated by an Asp-Asp dyad serves as the cofactor of TmCdsA. The results suggest a two-metal-ion catalytic mechanism for the Cds-mediated synthesis of CDP-DAG at the membrane-cytoplasm interface.},
  pmcid = {PMC4083444},
  pmid = {24968740},
  keywords = {{Protein Structure, Secondary},{Protein Structure, Tertiary},Bacterial Proteins,Cations,CDPdiacylglycerol-Serine O-Phosphatidyltransferase,Cell Membrane,duplicate-citation-key,Magnesium,Phospholipids,Potassium,Protein Structure Secondary,Protein Structure Tertiary,Thermotoga maritima}
}
