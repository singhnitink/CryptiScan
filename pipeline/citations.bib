@article{Teng2016,
  title = {Fluorescent {{Farnesyl Diphosphate Analogue}}: {{A Probe To Validate}} Trans-{{Prenyltransferase Inhibitors}}},
  shorttitle = {Fluorescent {{Farnesyl Diphosphate Analogue}}},
  author = {Teng, Kuo-Hsun and Hsu, Erh-Ting and Chang, Ying-Hsuan and Lin, Sheng-Wei and Liang, Po-Huang},
  year = 2016,
  month = aug,
  journal = {Biochemistry},
  volume = {55},
  number = {31},
  pages = {4366--4374},
  issn = {1520-4995},
  doi = {10.1021/acs.biochem.6b00486},
  abstract = {Some trans-prenyltransferases, such as long-chain C40 octaprenyl diphosphate synthase (OPPS), short-chain C15 farnesyl diphosphate synthase (FPPS), and C20 geranylgeranyl diphosphate synthase (GGPPS), are important drug targets. These enzymes catalyze chain elongation of FPP or geranyl diphosphate (GPP) through condensation reactions with isopentenyl diphosphate (IPP), forming designated numbers of trans-double bonds in the final products. To facilitate drug discovery, we report here a sensitive and reliable fluorescence-based assay for monitoring their activities in real time. MANT-O-GPP, a fluorescent analogue of FPP, was used as an alternative substrate and converted by the wild-type OPPS and the engineered FPPS and GGPPS into sufficiently long products with enhanced fluorescence intensities. This fluorescence probe was used to reveal the inhibitory mechanism of zoledronate, a bisphosphonate drug that targets human FPPS and possibly GGPPS.},
  langid = {english},
  pmid = {27428767},
  keywords = {{Models, Molecular},{Mutagenesis, Site-Directed},Alkyl and Aryl Transferases,Amino Acid Substitution,Dimethylallyltranstransferase,Diphosphonates,Drug Discovery,Enzyme Inhibitors,Farnesyltranstransferase,Fluorescent Dyes,Geranyltranstransferase,Humans,Imidazoles,Kinetics,Models Molecular,Molecular Probe Techniques,Molecular Probes,Mutagenesis Site-Directed,Polyisoprenyl Phosphates,Protein Conformation,Recombinant Proteins,Saccharomyces cerevisiae Proteins,Sesquiterpenes,Substrate Specificity,Zoledronic Acid}
}

@incollection{Terashima1993,
  title = {Comprehensive {{Model}} of the {{Lignified Plant Cell Wall}}},
  booktitle = {Forage {{Cell Wall Structure}} and {{Digestibility}}},
  author = {Terashima, N. and Fukushima, K. and He, L-F. and Takabe, K.},
  year = 1993,
  pages = {247--270},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.2134/1993.foragecellwall.c10},
  urldate = {2025-06-02},
  abstract = {This chapter proposes a comprehensive ultrastructural model of a lignified cell wall by integrating the results of observations of the processes in the deposition and assembly of cellulose, hemicelluloses (HC), and lignin throughout the formation of the cell wall. The most abundant constituent of cell wall, cellulose, occurs as crystalline micro fibrils that consist of dozens of straight chain molecules. The first step of the cell wall formation is the fusion of Golgi vesicles to form a cell plate, the main part of which is a hard gel consisting of pectin cross linked with Ca. In the next step, the primary walls are formed; it consists of cellulose microfibril and HC containing much arabinose and galactose. The formation of a cell wall in graminaceous plants proceeds in a quite different manner from that in woody plants. The most remarkable feature of cell wall structure is its heterogeneous nature.},
  chapter = {10},
  isbn = {978-0-89118-238-2},
  langid = {english},
  keywords = {arabinose,cell wall structure,cellulose microfibril,comprehensive model,galactose,Golgi vesicles,hemicelluloses,lignified plant cell wall,lignin}
}
