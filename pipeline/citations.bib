@incollection{Behr2022,
  title = {Chapter {{Three}} - {{Glycobiology}} of the Plant Secondary Cell Wall Dynamics},
  booktitle = {Advances in {{Botanical Research}}},
  author = {Behr, Marc and El Jaziri, Mondher and Baucher, Marie},
  editor = {Sibout, Richard},
  year = 2022,
  month = jan,
  series = {Lignin and {{Hydroxycinnamic Acids}}: {{Biosynthesis}} and the {{Buildup}} of the {{Cell Wall}}},
  volume = {104},
  pages = {97--131},
  publisher = {Academic Press},
  doi = {10.1016/bs.abr.2022.02.003},
  urldate = {2025-05-27},
  abstract = {Primary cell walls are synthesized during plant cell division and elongation whereas secondary cell walls (SCWs) provide rigidity to plant specific tissues that have completed their growth. The cell wall matrix is rich in cellulose, hemicelluloses and pectin polysaccharides as well as various aromatic compounds and proteins. Lignin of the SCW is mainly polymerized after the deposition of the polysaccharide framework. This local environment may affect lignin structure and properties. Hence, the biosynthesis and the function of SCW depend on a large variety of sugar moieties as well as glycosylation reactions. Cellulose is polymerized at the plasma membrane by cellulose synthase complexes while hemicelluloses such as xylan are synthesized in the Golgi and exported to the thickening cell wall. Among other biological processes, cell wall glycoproteins such as arabinogalactan proteins are involved in SCW deposition and structure, as well as sensing of developmental and environmental signals. Finally, in addition to transcriptional regulation, the pools of monolignols and the polymerization of lignin are also modulated through glycosylation reaction. Overall, this chapter illustrates the roles of glucan polymerization and of the de/glycosylation of carbohydrates, proteins and monolignols in the building of SCW matrix, as well as in the regulation of monolignol homeostasis and lignification. We illustrate how the glycosylation of laccases and peroxidases modifies their enzymatic activities. We also point out the differential accumulation of monolignol glucosides in angiosperms and gymnosperms and sum up the main reasons for such a divergence. We explain how glycosylation reactions at the basis of polysaccharides biosynthesis and monolignols' fate partake in the dynamics of the SCW to reach the advanced stages of cellular differentiation characterizing the vascular cells, a specificity of the plant kingdom.},
  keywords = {Cell wall proteins,Cellulose,Glycoproteins,Hemicellulose,Lignification,Monolignol glucosides,Polysaccharides,Secondary cell walls}
}
