@article{Heo2018,
  title = {What Makes It Difficult to Refine Protein Models Further via Molecular Dynamics Simulations?},
  author = {Heo, Lim and Feig, Michael},
  year = 2018,
  month = mar,
  journal = {Proteins},
  volume = {86},
  number = {S1},
  pages = {177--188},
  issn = {0887-3585, 1097-0134},
  doi = {10.1002/prot.25393},
  urldate = {2025-08-21},
  abstract = {Abstract             Protein structure refinement remains a challenging yet important problem as it has the potential to bring already accurate template-based models to near-native resolution. Refinement based on molecular dynamics simulations has been a highly promising approach and the performance of MD-based refinement in the Feig group during CASP12 is described here. During CASP12, sampling was extended well into the microsecond scale, an improved force field was applied, and new protocol variations were tested. Progress over previous rounds of CASP was found to be limited which is analyzed in terms of the quality of the initial models and dependency on the amount of sampling and refinement protocol variations. As current MD-based refinement protocols appear to be reaching a plateau, detailed analysis is presented to provide new insight into the major challenges towards more extensive structure refinement, focusing in particular on sampling with and without restraints.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#am},
  langid = {english},
  pmcid = {PMC5820117},
  pmid = {28975670},
  keywords = {{Crystallography, X-Ray},{Models, Molecular},{Sequence Analysis, Protein},Algorithms,CASP,Computational Biology,homology models,Humans,Markov state models,molecular dynamics simulation,Molecular Dynamics Simulation,Protein Conformation,protein structure prediction,Proteins,structure refinement}
}
