@article{Nakagame2010,
  title = {The Effect of Isolated Lignins, Obtained from a Range of Pretreated Lignocellulosic Substrates, on Enzymatic Hydrolysis},
  author = {Nakagame, Seiji and Chandra, Richard P. and Saddler, Jack N.},
  year = 2010,
