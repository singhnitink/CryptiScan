@article{Malavasi2016,
  title = {Lignin in {{Woody Plants}} under {{Water Stress}}: {{A Review}}},
  author = {Malavasi, Ubirajara Contro and Davis, Antony Swick and Malavasi, Marlene de Matos},
  year = 2016,
  month = sep,
  journal = {Floresta e Ambiente},
  volume = {23},
  number = {4},
  pages = {589--597},
  issn = {2179-8087},
  doi = {10.1590/2179-8087.143715},
  abstract = {ABSTRACT Under tropical and sub-tropical conditions, perennial woody plants most often encounter drought stress due to erratic rainfall, which has become compounded as result of recent climatic changes. Control of the efficiency and safety of water transport from roots to shoots is fundamental for plant survival under water stressed conditions. Lignin plays an important role in the life of terrestrial plants. Depending upon the stress, lignin plays protective, sustaining and disruptive roles in addition to its involvement in plant growth, development and defense responses. This review aims to present and summarize reported evidence on the possible role of lignin of plant tissue (in special woody species) in response to water limiting condition which is expected to increase because of environment changes.}
}
