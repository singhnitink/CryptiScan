@article{Chen2020,
  title = {Versatile Cis-Isoprenyl {{Diphosphate Synthase Superfamily Members}} in {{Catalyzing Carbon}}--{{Carbon Bond Formation}}},
  author = {Chen, Chun-Chi and Zhang, Lilan and Yu, Xuejing and Ma, Lixin and Ko, Tzu-Ping and Guo, Rey-Ting},
  year = 2020,
  month = apr,
  journal = {ACS Catal.},
  volume = {10},
  number = {8},
  pages = {4717--4725},
  publisher = {American Chemical Society},
  doi = {10.1021/acscatal.0c00283},
  urldate = {2024-02-27},
  abstract = {Isoprenyl diphosphate synthases (IDSs) catalyze condensation reactions of isoprene units to produce isoprenoids or terpenoids, the largest class of natural products on earth. IDSs are divided into trans- and cis-IDS superfamilies depending on the configuration of the resulting carbon--carbon double bonds. Compared with trans-IDSs, cis-IDS family members exhibit more variable active site structure and versatile function. The archetypal cis-IDSs are homodimers and produce linear isoprenoids via head-to-tail condensation. Recently, heterodimeric cis-IDSs containing a noncatalytic subunit that also belongs to the cis-IDS superfamily have been identified. Moreover, several cis-IDS-fold members have been found to produce nonlinear isoprenoids via ``head-to-middle'' condensation. In this Review, we summarize the structural features and catalytic mechanism of the versatile cis-IDS superfamily. This information provides important guidance for research regarding biosynthesis of important natural products and medical intermediates, cellular metabolism, and disease control.}
}
