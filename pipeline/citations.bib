@article{Iftimie2005,
  title = {{\emph{Ab Initio}} Molecular Dynamics: {{Concepts}}, Recent Developments, and Future Trends},
  shorttitle = {{\emph{Ab Initio}} Molecular Dynamics},
  author = {Iftimie, Radu and Minary, Peter and Tuckerman, Mark E.},
