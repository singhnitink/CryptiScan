@article{Marsili2008,
  title = {{\emph{Shewanella}} Secretes Flavins That Mediate Extracellular Electron Transfer},
  author = {Marsili, Enrico and Baron, Daniel B. and Shikhare, Indraneel D. and Coursolle, Dan and Gralnick, Jeffrey A. and Bond, Daniel R.},
  year = 2008,
