  author = {Gonz{\'a}lez, Alexis and {Covarrubias-Pinto}, Adriana and Bhaskara, Ramachandra M. and Glogger, Marius and Kuncha, Santosh K. and Xavier, Audrey and Seemann, Eric and Misra, Mohit and Hoffmann, Marina E. and Br{\"a}uning, Bastian and Balakrishnan, Ashwin and Qualmann, Britta and D{\"o}tsch, Volker and Schulman, Brenda A. and Kessels, Michael M. and H{\"u}bner, Christian A. and Heilemann, Mike and Hummer, Gerhard and Diki{\'c}, Ivan},
  year = 2023,
