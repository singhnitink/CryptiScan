@article{Bennett2008,
  title = {A Ternary Complex of Hydroxycinnamoyl-{{CoA}} Hydratase-Lyase ({{HCHL}}) with Acetyl-{{CoA}} and Vanillin Gives Insights into Substrate Specificity and Mechanism.},
  author = {Bennett, Joseph P and Bertin, Lucille and Moulton, Benjamin and Fairlamb, Ian J S and Brzozowski, A Marek and Walton, Nicholas J and Grogan, Gideon},
