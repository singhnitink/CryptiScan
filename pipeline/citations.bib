  keywords = {{Protein Structure, Secondary},{Protein Structure, Tertiary},Capsid,Capsid Proteins,Capsid Proteins: chemistry,Capsid Proteins: ultrastructure,Capsid: chemistry,Capsid: ultrastructure,CellModel,Chemistry and Materials Science,Cryoelectron Microscopy,duplicate-citation-key,HIV-1,HIV-1: chemistry,HIV-1: ultrastructure,Human Immunodeficiency Virus Proteins,Human Immunodeficiency Virus Proteins: chemistry,Human Immunodeficiency Virus Proteins: ultrastruct,Hydrophobic and Hydrophilic Interactions,Molecular Dynamics Simulation,Protein Multimerization,Protein Structure Secondary,Protein Structure Tertiary}
