@article{Nishiyama2002,
  title = {Crystal Structure and Hydrogen-Bonding System in Cellulose 1 Beta from Synchrotron {{X-ray}} and Neutron Fiber Diffraction},
  author = {Nishiyama, Yoshiharu and Langan, Paul and Chanzy, Henri},
  year = 2002,
