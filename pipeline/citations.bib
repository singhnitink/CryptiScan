@article{Elmore2021,
  title = {Production of Itaconic Acid from Alkali Pretreated Lignin by Dynamic Two Stage Bioconversion},
  author = {Elmore, Joshua R. and Dexter, Gara N. and Salvach{\'u}a, Davinia and {Martinez-Baird}, Jessica and Hatmaker, E. Anne and Huenemann, Jay D. and Klingeman, Dawn M. and Peabody, George L. and Peterson, Darren J. and Singer, Christine and Beckham, Gregg T. and Guss, Adam M.},
