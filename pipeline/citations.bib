@article{Guixa-Gonzalez2014,
  title = {{{MEMBPLUGIN}}: Studying Membrane Complexity in {{VMD}}},
  shorttitle = {{{MEMBPLUGIN}}},
  author = {{Guix{\`a}-Gonz{\'a}lez}, Ramon and {Rodriguez-Espigares}, Ismael and {Ram{\'i}rez-Anguita}, Juan Manuel and {Carri{\'o}-Gaspar}, Pau and {Martinez-Seara}, Hector and Giorgino, Toni and Selent, Jana},
