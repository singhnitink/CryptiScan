@article{Karrenbrock2024a,
  title = {Absolute {{Binding Free Energies}} with {{OneOPES}}},
  author = {Karrenbrock, Maurice and Borsatto, Alberto and Rizzi, Valerio and Lukauskis, Dominykas and Aureli, Simone and Luigi Gervasio, Francesco},
  year = 2024,
