@article{Zimmerman2020,
  title = {Designing for a Green Chemistry Future},
  author = {Zimmerman, Julie B. and Anastas, Paul T. and Erythropel, Hanno C. and Leitner, Walter},
  year = 2020,
  month = jan,
  journal = {Science},
  volume = {367},
