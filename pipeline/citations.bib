@article{Grabinska2017,
  title = {A Conserved {{C-terminal R}}{{{\emph{X}}}}{{G}} Motif in the {{NgBR}} Subunit of {\emph{Cis}}-Prenyltransferase Is Critical for Prenyltransferase Activity},
  author = {Grabi{\'n}ska, Kariona A. and Edani, Ban H. and Park, Eon Joo and Kraehling, Jan R. and Sessa, William C.},
