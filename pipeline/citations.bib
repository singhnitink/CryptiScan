@article{Li2014q,
  title = {Investigation of Lignin Deposition on Cellulose during Hydrothermal Pretreatment, Its Effect on Cellulose Hydrolysis, and Underlying Mechanisms},
  author = {Li, Hongjia and Pu, Yunqiao and Kumar, Rajeev and Ragauskas, Arthur J. and Wyman, Charles E.},
  year = 2014,
  month = mar,
  journal = {Biotechnol. Bioeng.},
  volume = {111},
  number = {3},
  pages = {485--492},
