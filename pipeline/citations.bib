  pages = {4856--4865},
  issn = {1864-5631, 1864-564X},
  doi = {10.1002/cssc.202001433},
  urldate = {2024-01-09},
  abstract = {Abstract There is a growing interest in using ammonia as a liquid carrier of hydrogen for energy applications. Currently, ammonia is produced industrially by the Haber-Bosch process, which requires high temperature and high pressure. In contrast, bacteria have naturally evolved an enzyme known as nitrogenase, that is capable of producing ammonia and hydrogen at ambient temperature and pressure. Therefore, nitrogenases are attractive as a potentially more efficient means to produce ammonia via harnessing the unique properties of this enzyme. In recent years, exciting progress has been made in bioelectrocatalysis using nitrogenases to produce ammonia. Here, the prospects for developing biological ammonia production are outlined, key advances in bioelectrocatalysis by nitrogenases are highlighted, and possible solutions to the obstacles faced in realising this goal are discussed.},
  langid = {english},
  pmid = {32696610}
}
