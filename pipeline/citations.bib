@article{Isaksen2014a,
  title = {A {{C4-oxidizing}} Lytic Polysaccharide Monooxygenase Cleaving Both Cellulose and Cello-Oligosaccharides.},
  author = {Isaksen, Trine and Westereng, Bj{\o}rge and Aachmann, Finn L and Agger, Jane W and Kracher, Daniel and Kittl, Roman and Ludwig, Roland and Haltrich, Dietmar and Eijsink, Vincent G H and Horn, Svein J},
  year = 2014,
