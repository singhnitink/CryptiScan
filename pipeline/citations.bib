@article{Braga2021,
  title = {Zymomonas Mobilis as an Emerging Biotechnological Chassis for the Production of Industrially Relevant Compounds},
  author = {Braga, Adelaide and Gomes, Daniela and Rainha, Jo{\~a}o and Amorim, Cl{\'a}udia and Cardoso, Beatriz B. and Gudi{\~n}a, Eduardo J. and Silv{\'e}rio, Sara C. and Rodrigues, Joana L. and Rodrigues, L{\'i}gia R.},
  year = 2021,
