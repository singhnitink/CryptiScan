@article{Knauf2002,
  title = {Functional Characterization and Immunolocalization of the Transporter Encoded by the Life-Extending Gene {{Indy}}.},
  author = {Knauf, Felix and Rogina, Blanka and Jiang, Zhirong and Aronson, Peter S and Helfand, Stephen L},
  year = 2002,
