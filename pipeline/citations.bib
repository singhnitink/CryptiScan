@article{MacKerell2004,
  title = {Improved Treatment of the Protein Backbone in Empirical Force Fields.},
  author = {MacKerell, Alexander D and Feig, Michael and Brooks, Charles L},
  year = 2004,
  month = jan,
  journal = {J. Am. Chem. Soc.},
  volume = {126},
  number = {3},
  pages = {698--699},
  issn = {0002-7863},
  doi = {10.1021/ja036959e},
  urldate = {2014-08-15},
  abstract = {Empirical force field-based calculations of proteins, including protein-folding studies, have improved our understanding of the relationship of their structure to their biological function. However, limitations in the accuracy of empirical force fields in the treatment of the peptide backbone exist. Presented is a grid correction approach to improve the treatment of the peptide backbone phi/psi conformational energies. Inclusion of this correction with the CHARMM22 all-atom protein force field is shown to lead to significant improvement in the treatment of the conformational energies of both the peptide model compound, the alanine dipeptide, and of proteins in their crystal environment. The developed approach is suggested to lead to significant improvements in the accuracy of empirical force fields to treat peptides and proteins.},
  isbn = {0002-7863},
  pmid = {14733527},
  keywords = {{Models, Chemical},Chemical,Dipeptides,Dipeptides: chemistry,Glycine,Glycine: chemistry,Models,Models Chemical,Protein Conformation,Proteins,Proteins: chemistry,Static Electricity,Structure-Activity Relationship,Surface Properties,Thermodynamics}
}
