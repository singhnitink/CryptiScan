@article{Kondakova2019,
  title = {Transcriptional Regulation of Fatty Acid {\emph{Cis}} -- {\emph{Trans}} Isomerization in the Solvent-Tolerant Soil Bacterium, {{{\emph{Pseudomonas}}}}{\emph{ Putida}} {{F1}}},
  author = {Kondakova, Tatiana and Cronan, John E.},
  year = 2019,
