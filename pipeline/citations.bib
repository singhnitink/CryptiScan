@article{Ning2021,
  title = {Recent Advances in the Valorization of Plant Biomass},
  author = {Ning, Peng and Yang, Guofeng and Hu, Lihong and Sun, Jingxin and Shi, Lina and Zhou, Yonghong and Wang, Zhaobao and Yang, Jianming},
  year = 2021,
