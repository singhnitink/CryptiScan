@article{Ibrahim2025,
  title = {Ethanol Production from Lignocellulosic Waste Materials: Kinetics and Optimization Studies},
  shorttitle = {Ethanol Production from Lignocellulosic Waste Materials},
  author = {Ibrahim, Naeemah A. and Majeed, Halah Hameed and Abid, Rand A. and Alsultan, G. Abdulkareem and Mijan, N. Asikin and Lee, H. V. and Kurniawan, Tonni Agustiono and {Taufiq-Yap}, Yun Hin},
  year = 2025,
  journal = {RSC Adv.},
  volume = {15},
