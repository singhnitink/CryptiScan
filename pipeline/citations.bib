@article{Dikiy2013,
  title = {N-Terminal Acetylation Stabilizes {{N-terminal}} Helicity in Lipid- and Micelle-Bound Alpha-Synuclein and Increases Its Affinity for Physiological Membranes.},
  author = {Dikiy, Igor and Eliezer, David},
  year = 2013,
  month = dec,
  journal = {J. Biol. Chem.},
  issn = {1083-351X},
  doi = {10.1074/jbc.M113.512459},
  urldate = {2014-01-20},
  abstract = {The Parkinson's disease protein alpha-synuclein is N-terminally acetylated, but most in vitro studies have been performed using unacetylated alpha-synuclein. Binding to lipid membranes is considered key to the still poorly understood function of alpha-synuclein. We report the effects of N-terminal acetylation on alpha-synuclein binding to lipid vesicles of different composition and curvature and to micelles composed of the detergents BOG ({$\beta$}-octyl-glucoside) and SDS. In the presence of SDS, N-terminal acetylation results in a slightly increased helicity for the N-terminal \textasciitilde 10 residues of the protein, likely due to the stabilization of N-terminal fraying through the formation of a helix cap motif. In the presence of BOG, a detergent used in previous isolations of helical oligomeric forms of alpha-synuclein, the N-terminally acetylated protein adopts a novel conformation, in which the N-terminal \textasciitilde 30 residues bind the detergent micelle in a partly helical conformation while the remainder of the protein remains unbound and disordered. Binding of alpha-synuclein to lipid vesicles with high negative charge content is essentially unaffected by N-terminal acetylation, irrespective of curvature, but binding to vesicles of lower negative charge content is increased, with stronger binding observed for vesicles with higher curvature. Thus, the naturally occurring N-terminally acetylated form of alpha-synuclein exhibits stabilized helicity at its N-terminus and increased affinity for lipid vesicles similar to synaptic vesicles, a binding target of the protein in vivo. Further, the novel BOG-bound state of N-terminally acetylated alpha-synuclein may serve as a model of partly helical membrane-bound intermediates with a role in alpha-synuclein function and dysfunction.},
  pmcid = {PMC3916564},
  pmid = {24338013},
  keywords = {-Synuclein,{$\alpha$}-Synuclein,{Membranes, Artificial},{Models, Molecular},{Protein Structure, Secondary},Acetylation,alpha-Synuclein,Glucosides,Humans,Lipid-binding Protein,Membranes Artificial,Micelles,Models Molecular,N-terminal Acetylation,Parkinson Disease,Post Translational Modification,Protein Aggregation,Protein Stability,Protein Structure Secondary,Sodium Dodecyl Sulfate,Synuclein}
}
