@article{Arias-Hidalgo2018,
  title = {Cholesterol Is the Main Regulator of the Carbon Dioxide Permeability of Biological Membranes},
  author = {{Arias-Hidalgo}, Mariela and {Al-Samir}, Samer and Gros, Gerolf and Endeward, Volker},
  year = 2018,
  month = aug,
  journal = {Am. J. Physiol.-Cell Physiol.},
  volume = {315},
  number = {2},
  pages = {C137-C140},
  issn = {0363-6143},
  doi = {10.1152/ajpcell.00139.2018},
  abstract = {We present here a compilation of membrane CO 2 permeabilities (Pco 2 ) for various cell types from the literature. Pco 2 values vary over more than two orders of magnitude. Relating Pco 2 to the cholesterol content of the membranes shows that, with the exception of red blood cells, it is essentially membrane cholesterol that determines the value of Pco 2 . Thus, the observed strong modulation of Pco 2 in the majority of membranes is caused by cholesterol rather than gas channels.},
