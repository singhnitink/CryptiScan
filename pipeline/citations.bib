  keywords = {{Models, Molecular},{Scattering, Radiation},Cell Wall,Cellulose,duplicate-citation-key,Fabaceae,Magnetic Resonance Spectroscopy,Microfibrils,Models Molecular,Scattering Radiation,X-Ray Diffraction}
