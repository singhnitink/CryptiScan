@article{Eswaran2022,
  title = {Molecular Structural Dataset of Lignin Macromolecule Elucidating Experimental Structural Compositions},
  author = {Eswaran, Sudha Cheranma Devi and Subramaniam, Senthil and Sanyal, Udishnu and Rallo, Robert and Zhang, Xiao},
  year = 2022,
