@article{Lendenmann1996,
  title = {2-Aminophenol 1,6-Dioxygenase: A Novel Aromatic Ring Cleavage Enzyme Purified from {{Pseudomonas}} Pseudoalcaligenes {{JS45}}},
  shorttitle = {2-Aminophenol 1,6-Dioxygenase},
  author = {Lendenmann, U and Spain, J C},
  year = 1996,
