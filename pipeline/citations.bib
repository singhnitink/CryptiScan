@article{Hemsworth2013,
  title = {Discovery and Characterization of a New Family of Lytic Polysaccharide Monooxygenases},
  author = {Hemsworth, Glyn R and Henrissat, Bernard and Davies, Gideon J and Walton, Paul H},
  year = 2013,
  month = dec,
  journal = {Nat. Chem. Biol.},
  volume = {10},
  number = {2},
  eprint = {24362702},
  eprinttype = {pubmed},
  pages = {122--126},
  issn = {1552-4469 (Electronic)\textbackslash r1552-4450 (Linking)},
  doi = {10.1038/nchembio.1417},
  urldate = {2014-09-18},
  abstract = {Lytic polysaccharide monooxygenases (LPMOs) are a recently discovered class of enzymes capable of oxidizing recalcitrant polysaccharides. They are attracting considerable attention owing to their potential use in biomass conversion, notably in the production of biofuels. Previous studies have identified two discrete sequence-based families of these enzymes termed AA9 (formerly GH61) and AA10 (formerly CBM33). Here, we report the discovery of a third family of LPMOs. Using a chitin-degrading exemplar from Aspergillus oryzae, we show that the three-dimensional structure of the enzyme shares some features of the previous two classes of LPMOs, including a copper active center featuring the 'histidine brace' active site, but is distinct in terms of its active site details and its EPR spectroscopy. The newly characterized AA11 family expands the LPMO clan, potentially broadening both the range of potential substrates and the types of reactive copper-oxygen species formed at the active site of LPMOs.},
  isbn = {1552-4469 (Electronic)\textbackslash r1552-4450 (Linking)},
  pmcid = {PMC4274766},
  pmid = {24362702},
  keywords = {{Crystallography, X-Ray},{Protein Structure, Tertiary},Aspergillus oryzae,Aspergillus oryzae: enzymology,Base Sequence,Catalytic Domain,Copper,Copper: chemistry,Crystallography,Crystallography X-Ray,Electron Spin Resonance Spectroscopy,Mixed Function Oxygenases,Mixed Function Oxygenases: chemistry,Mixed Function Oxygenases: genetics,Mixed Function Oxygenases: metabolism,Polysaccharides,Polysaccharides: chemistry,Polysaccharides: metabolism,Protein Structure,Protein Structure Tertiary,Sequence Alignment,Tertiary,X-Ray}
