@article{Kumazaki2014,
  title = {Crystal Structure of {{Escherichia}} Coli {{YidC}}, a Membrane Protein Chaperone and Insertase.},
  author = {Kumazaki, Kaoru and Kishimoto, Toshiki and Furukawa, Arata and Mori, Hiroyuki and Tanaka, Yoshiki and Dohmae, Naoshi and Ishitani, Ryuichiro and Tsukazaki, Tomoya and Nureki, Osamu},
