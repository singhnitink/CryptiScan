@article{Tikkanen2012,
  title = {Regulation of the Photosynthetic Apparatus under Fluctuating Growth Light},
  author = {Tikkanen, Mikko and Grieco, Michele and Nurmi, Markus and Rantala, Marjaana and Suorsa, Marjaana and Aro, Eva-Mari},
