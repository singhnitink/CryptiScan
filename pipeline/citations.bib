@article{Lokappa2011,
  title = {Alpha-Synuclein Populates Both Elongated and Broken Helix States on Small Unilamellar Vesicles.},
  author = {Lokappa, Sowmya Bekshe and Ulmer, Tobias S},
  year = 2011,
  month = jun,
  journal = {J. Biol. Chem.},
  volume = {286},
  number = {24},
  pages = {21450--7},
  issn = {1083-351X},
  doi = {10.1074/jbc.M111.224055},
  urldate = {2013-09-17},
  abstract = {The misfolding of the protein {$\alpha$}-synuclein ({$\alpha$}S) has been implicated in the molecular chain of events leading to Parkinson disease. Physiologically, {$\alpha$}S undergoes a transition from a random coil to helical conformation upon encountering synaptic vesicle membranes. On analogous small unilamellar vesicles (SUVs), the conformation of {$\alpha$}S is dominated by a single elongated {$\alpha$}S helix. However, alternative broken helix states have been postulated, mandating experimental clarification. Here, the upper limit for the free energy difference between elongated and broken helix conformations on SUVs resembling synaptic vesicles was determined to be 1.2 \textpm{} 0.4 kcal/mol, which amounts to a population ratio of 7.6:1 between both states (12\% broken helices). In response to helix breaks at different positions, {$\alpha$}S rearranged in an opportunistic manner, thereby minimizing helix abrogations to as little as one to two turns. Enthalpy and entropy measurements of gel state SUV-{$\alpha$}S interactions indicated that broken helix states retain the ability to relieve membrane-packing stress. Thus, broken helix states are a distinct physiological feature of the vesicle-bound {$\alpha$}S state, making it a "checkered" protein of multiple parallel conformations. A continuous interconversion between structural states may contribute to pathological {$\alpha$}S misfolding.},
  pmcid = {PMC3122204},
  pmid = {21524999},
  keywords = {{Protein Structure, Secondary},alpha-Synuclein,alpha-Synuclein: metabolism,Amino Acid Sequence,Calorimetry,Cell Membrane,Cell Membrane: metabolism,Circular Dichroism,Cysteine,Cysteine: genetics,Humans,Molecular Sequence Data,Protein Binding,Protein Conformation,Protein Folding,Protein Structure,Protein Structure Secondary,Secondary,Temperature,Thermodynamics,Unilamellar Liposomes,Unilamellar Liposomes: chemistry}
}
