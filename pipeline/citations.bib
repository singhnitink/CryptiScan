@article{Glithero2013,
  title = {At-Line Measurement of Lactose in Dairy-Processing Plants},
  author = {Glithero, Nick and Clark, Claire and Gorton, Lo and Schuhmann, Wolfgang and Pasco, Neil},
  year = 2013,
