@article{Talandashti2024,
  title = {Model {{Mechanism}} for {{Lipid Uptake}} by the {{Human STARD2}}/{{PC-TP Phosphatidylcholine Transfer Protein}}},
  author = {Talandashti, Reza and Moqadam, Mahmoud and Reuter, Nathalie},
