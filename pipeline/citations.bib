  keywords = {{ATP Binding Cassette Transporter, Subfamily B, Member 1},{Cell Line, Tumor},{Leukemia, Lymphoid},ATP Binding Cassette Transporter Subfamily B Member 1,ATP-Binding Cassette Transporters,ATP-Binding Cassette Transporters: metabolism,Cell Line,Cell Line Tumor,Cholesterol,Cholesterol: metabolism,Humans,Leukemia,Leukemia Lymphoid,Lymphoid,Lymphoid: metabolism,Membrane Fluidity,Membrane Microdomains,Membrane Microdomains: metabolism,P-Glycoprotein,P-Glycoprotein: metabolism,Tumor}
}
