@article{Glaser2021,
  title = {High-Throughput Virtual Laboratory for Drug Discovery Using Massive Datasets},
  author = {Glaser, Jens and Vermaas, Josh V and Rogers, David M and Larkin, Jeff and LeGrand, Scott and Boehm, Swen and Baker, Matthew B and Scheinberg, Aaron and Tillack, Andreas F and Thavappiragasam, Mathialakan and Sedova, Ada and Hernandez, Oscar},
  year = 2021,
