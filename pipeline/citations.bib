@article{Ulander2003,
  title = {Permeation {{Across Hydrated DPPC Lipid Bilayers}}: {{Simulation}} of the {{Titrable Amphiphilic Drug Valproic Acid}}},
  shorttitle = {Permeation {{Across Hydrated DPPC Lipid Bilayers}}},
  author = {Ulander, Johan and Haymet, A D J},
  year = 2003,
