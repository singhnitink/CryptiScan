@article{Hart2012,
  title = {Optimization of the {{CHARMM}} Additive Force Field for {{DNA}}: {{Improved}} Treatment of the {{BI}}/{{BII}} Conformational Equilibrium},
  shorttitle = {Optimization of the {{CHARMM Additive Force Field}} Fo},
  author = {Hart, Katarina and Foloppe, Nicolas and Baker, Christopher M. and Denning, Elizabeth J. and Nilsson, Lennart and MacKerell, Alexander D.},
